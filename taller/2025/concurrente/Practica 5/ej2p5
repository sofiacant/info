programa ej2p5
procesos
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso enviarIds
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso inicializar(ES ok1:boolean;ES ok2:boolean;ES ok3:boolean)
  comenzar
    ok1:=V
    ok2:=V
    ok3:=V
  fin
  proceso etapa(ES flores:numero)
  variables
    av,ca:numero
  comenzar
    repetir 9
      juntarFlores(flores)
      mover
    juntarFlores(flores)
    av:=PosAv
    ca:=PosCa
    BloquearEsquina(50,50)
    Pos(50,50)
    si(flores>0)
      repetir flores
        depositarFlor
        flores:=flores-1
    Pos(av,ca)
    LiberarEsquina(50,50)
  fin
areas
  arear1: AreaP (1,1,100,1)
  arear2: AreaP(1,2,100,2)
  arear3: AreaP(1,3,100,3)
  arearf: AreaP(1,4,1,4)
  esq: AreaC (50,50,50,50)
  
robots
  robot recolector
  variables
    flores,id:numero
  comenzar
    flores:=0
    RecibirMensaje(id,rf)
    derecha
    repetir 11
      etapa(flores)
    EnviarMensaje(id,rf)
    EnviarMensaje(F,rf)
  fin
  robot rfiscalizador
  variables
    ok1,ok2,ok3:boolean
    flores,id:numero
  comenzar
    flores:=0
    enviarIds
    inicializar(ok1,ok2,ok3)
    mientras(ok1)|(ok2)|(ok3)
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(ok1,r1)
      sino
        si(id=2)
          RecibirMensaje(ok2,r2)
        sino
          RecibirMensaje(ok3,r3)
    BloquearEsquina(50,50)
    Pos(50,50)
    juntarFlores(flores)
    Pos(1,4)
    LiberarEsquina(50,50)
    Informar('flores',flores)
  fin
variables
  r1,r2,r3: recolector
  rf:rfiscalizador
comenzar
  AsignarArea(r1, arear1)
  AsignarArea(r2, arear2)
  AsignarArea(r3, arear3)
  AsignarArea(rf,arearf)
  AsignarArea(r1,esq)
  AsignarArea(r2,esq)
  AsignarArea(r3,esq)
  AsignarArea(rf,esq)
  Iniciar(r1, 1,1)
  Iniciar(r2, 1,2)
  Iniciar(r3, 1,3)
  Iniciar(rf, 1,4)
fin