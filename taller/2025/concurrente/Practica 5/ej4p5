programa ej4p5
procesos
  proceso enviarFindeIntentos
  comenzar
    EnviarMensaje(F,r1)
    EnviarMensaje(F,r2) 
    EnviarMensaje(F,r3)
  fin
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores+1
  fin
  proceso juntarEnCuadrante(ES flores:numero; E av:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    juntarFlores(flores)
    Pos(avIni,caIni)
    LiberarEsquina(av,ca)
  fin
  proceso depositarFlores(ES flores:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:= PosAv
    caIni:=PosCa
    BloquearEsquina(10,10)
    Pos(10,10)
    repetir flores
      depositarFlor
    Pos(avIni,caIni)
    LiberarEsquina(10,10)
    EnviarMensaje(flores,rf)
  fin
areas
  cuadrante: AreaC (40,40,60,60)
  esquina: AreaPC(10,10,10,10)
  areafiscal: AreaP(4,1,4,1)
  area1: AreaP (1,1,1,1)
  area2: AreaP(2,1,2,1)
  area3: AreaP(3,1,3,1)
robots
  robot rfloreros
  variables
    av,ca:numero
    finInt,ok:boolean
    flores:numero
  comenzar
    flores:=0
    RecibirMensaje(ok,rf)
    mientras(ok)
      RecibirMensaje(av,rf)
      RecibirMensaje(ca,rf)
      juntarEnCuadrante(flores,av,ca)
      RecibirMensaje(ok,rf)
    depositarFlores(flores)     
  fin
  robot rfiscalizador
  variables
    av,ca:numero
    r:numero
    totalF,flores:numero
  comenzar
    totalF:=0
    repetir 8
      Random(r,1,3)
      si(r=1)
        Random(av,40,60)
        Random(ca,40,60)
        EnviarMensaje(V,r1)
        EnviarMensaje(av,r1)
        EnviarMensaje(ca,r1)
      sino
        si(r=2)
          Random(av,40,60)
          Random(ca,40,60)
          EnviarMensaje(V,r2)
          EnviarMensaje(av,r2)
          EnviarMensaje(ca,r2)
        sino
          Random(av,40,60)
          Random(ca,40,60)
          EnviarMensaje(V,r3)
          EnviarMensaje(av,r3)
          EnviarMensaje(ca,r3)  
    enviarFindeIntentos    
    repetir 3
      RecibirMensaje(flores,*)
      totalF:=totalF+ flores     
    Informar('flores',flores)
  fin
variables
  r1,r2,r3: rfloreros
  rf:rfiscalizador
comenzar
  AsignarArea(r1, cuadrante)
  AsignarArea(r1,area1)
  AsignarArea(r1,esquina)
  AsignarArea(r2,cuadrante)
  AsignarArea(r2,area2)
  AsignarArea(r2,esquina)
  AsignarArea(r3, cuadrante)
  AsignarArea(r3,area3)
  AsignarArea(r3,esquina)
  AsignarArea(rf, areafiscal)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,1)
  Iniciar(r3, 3,1)
  Iniciar(rf,4,1)
fin