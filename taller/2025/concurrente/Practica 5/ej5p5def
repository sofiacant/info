programa parcialturnod
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,rp1)
    EnviarMensaje(2,rp2)
    EnviarMensaje(3,rflo)
  fin
  proceso depositarPapelesEsq(E ca:numero; ES papeles:numero)
  comenzar
    Pos(1,ca)
    repetir 99
      si(~HayPapelEnLaEsquina)
        depositarPapel
      mover
  fin
  
  proceso  depositarFloresEsq(E av:numero; ES flores:numero)
  comenzar
    Pos(av,1)
    Repetir 99
      si(~HayFlorEnLaEsquina)
        depositarFlor
        flores:=flores+1
      mover
  fin
areas
  arearp2: AreaC (1,15,100,15)
  arearp1: AreaP(1,8,100,8)
  areaflo: AreaP(1,2,1,2)
  arearfisc: AreaP(1,1,1,1)
  areaAleatoria: AreaPC (2,1,35,100)
robots
  robot rpapelero
  variables
    ca:numero
    id:numero
    volver:numero
  comenzar
    ca:=PosCa
    depositarPapelesEsq(ca)
    RecibirMensaje(id,fisc)
    EnviarMensaje(id,fisc)
    RecibirMensaje(volver,fisc)
    si(volver)
      Pos(1,ca)
      Informar('Papeles',papeles)
  fin
  robot rflorero
  variables
    avAle:numero
    id:numero
    volver:boolean
    flores:numero
  comenzar
    RecibirMensaje(avAle,fisc)
    RecibirMensaje(id,fisc)
    depositarFloresEsq(avAle,flores)
    EnviarMensaje(id,fisc)
    RecibirMensaje(volver,fisc)
    si(volver)
      Pos(1,2)
      EnviarMensaje(flores,fisc)    
  fin
  robot rfiscalizador
  variables
    avAle:numero
    cont:numero
  comenzar
    enviarIDs
    Random(avAle,2,35)
    EnviarMensaje(avAle,rflo)
    RecibirMensaje(id,*)
    si (id=1)
      EnviarMensaje(V,rp1)
      EnviarMensaje(F,rp2)
      EnviarMensaje(F,rflo)
    sino
      si(id=2)
        EnviarMensaje(V,rp2)
        EnviarMensaje(F,rp1)
        EnviarMensaje(F,rflo)
      sino
        EnviarMensaje(V,rflo)
        EnviarMensaje(F,rp1)
        EnviarMensaje(F,rp2)
    repetir 2
      RecibirMensaje(id,*)
     
  fin
variables
  rp1,rp2: rpapelero
  rflo:rflorero
  fisc:rfiscalizador
comenzar
  AsignarArea(rp1, arearp1)
  AsignarArea(rp2, arearp2)
  AsignarArea(rflo, areaflo)
  AsignarArea(rflo,areaAleatoria)
  AsignarArea(fisc,arearfisc)
  Iniciar(rp1, 1,8)
  Iniciar(rp2, 1,15)
  Iniciar(rflo, 1,2)
  Iniciar(fisc, 1,1)
fin
