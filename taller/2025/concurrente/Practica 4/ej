programa ej1p4
procesos
  proceso depositarFenEsquina(E av: numero;E ca:numero; ES flores:numero)
  comenzar
    Pos(av,ca)
    repetir flores
      depositarFlor
  fin
  proceso juntaryDepositar(E av: numero;E ca:numero)
  comenzar
    Pos(av,ca)
    Mientras(HayFlorEnLaEsquina)
      tomarFlor
    mientras (av < 99)
      depositarFlor   
  fin
areas
  areaServidor: AreaP (100,100,100,100)
  areaCliente1: AreaP (1,1,1,1)
  areaCliente2: AreaP (2,1,2,1)
  areaCliente3: AreaP (3,1,3,1)
robots
  robot rCliente
  variables
    av,ca:numero
  comenzar
    av:=PosAv 
    ca:=PosCa+1
    EnviarMensaje(av,rServidor)
    EnviarMensaje(ca,rServidor)
    juntaryDepositar(av,ca)
  fin
  robot rServidor
  variables
    flores:numero
  comenzar
    Random(flores,1,4) 
    RecibirMensaje(av,*) 
    RecibirMensaje(ca,*)
    depositarFenEsquina(av,ca,flores) 
  fin     
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,1)
  Iniciar(r3, 3,1)
fin