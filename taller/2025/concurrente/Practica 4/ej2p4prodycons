programa ej2P4
procesos
  proceso juntarPapeles(ES papeles: numero)
  variables
    avIni,caIni: numero
  comenzar 
    avIni := PosAv
    caIni := PosCa
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles := papeles + 1
      si(papeles = 5)
        BloquearEsquina(50,50)
        Pos(50,50)
        repetir papeles
          depositarPapel
        Pos(avIni,caIni)
        LiberarEsquina(50,50)
        papeles := 0
  fin
  proceso recorrerAvenida
  variables
    papeles: numero
  comenzar
    papeles := 0
    repetir 99
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)
  fin
areas
  esq: AreaC (50,50,50,50)
  av5: AreaP(5,1,5,100)
  av10: AreaP(10,1,10,100)
  areac1: AreaP(11,1,11,1)
  areac2: AreaP(12,1,12,1)
robots
  robot rproductor
  comenzar
    recorrerAvenida
  fin
  robot rconsumidor
  variables
    intentos,cantP,pap,avIni,caIni: numero
  comenzar
    avIni := PosAv
    caIni := PosCa
    intentos := 0
    mientras(intentos < 8)
      Random(cantP,2,5)
      BloquearEsquina(50,50)
      Pos(50,50)
      cantP := 0
      mientras((HayPapelEnLaEsquina)&(cantP < pap))
        tomarPapel
        cantP := cantP + 1
      si(cantP = pap)
        Pos(avIni,caIni)
        LiberarEsquina(50,50)
        repetir cantP
          depositarPapel
        intentos := 0
      sino
        repetir cantP
          depositarPapel
        Pos(avIni,caIni)
        LiberarEsquina(50,50)
        intentos := intentos + 1
  fin
variables
  rp1,rp2: rproductor
  rc1,rc2: rconsumidor
comenzar
  AsignarArea(rp1,av5)
  AsignarArea(rp1,esq)
  AsignarArea(rp2,av10)
  AsignarArea(rp2,esq)
  AsignarArea(rc1,areac1)
  AsignarArea(rc1,esq)
  AsignarArea(rc2,areac2)
  AsignarArea(rc2,esq)
  Iniciar(rp1,5,1)
  Iniciar(rp2,10,1)
  Iniciar(rc1,11,1)
  Iniciar(rc2,12,1)
fin