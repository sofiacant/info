programa eje6p3
procesos
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras HayFlorEnLaEsquina
      tomarFlor
      flores:=flores + 1
  fin
  proceso juntarTodo(ES cant:numero)
  comenzar
    mientras HayPapelEnLaEsquina
      tomarPapel
      cant:=cant + 1
    mientras HayFlorEnLaEsquina
      tomarFlor
      cant:=cant + 1
  fin
  proceso restoDelLado(ES cant:numero)
  comenzar
    repetir 6
      juntarTodo(cant)
      mover
  fin  
  proceso recorrerF(ES flores:numero)
  comenzar
    repetir 6
      juntarFlores(flores)
      mover
    derecha
  fin
  proceso recorrerFyPlado2y3(ES cant:numero)
  comenzar
    repetir 2
      repetir 10
        juntarTodo(cant)
        mover
      derecha
  fin
  proceso ladoColision58(ES cant:numero)
  comenzar
    repetir 2
      mover
    BloquearEsquina(5,8)
    mover
    juntarTodo(cant)
    mover
    LiberarEsquina(5,8)
    restoDelLado(cant)
    derecha
  fin
  proceso ladoColision85(ES cant:numero)
  comenzar
    restoDelLado(cant)
    BloquearEsquina(8,5)
    mover
    juntarTodo(cant)
    mover
    LiberarEsquina(8,5)
    repetir 2
      juntarTodo(cant)
      mover
    derecha
  fin
  proceso ladoColisionR1(ES flores:numero;E av:numero; E ca:numero)
  comenzar
    repetir 2
      juntarFlores(flores)
      mover
    BloquearEsquina(av,ca)
    mover
    juntarFlores(flores)
    mover
    LiberarEsquina(av,ca)
    repetir 2
      juntarFlores(flores)
      mover
    derecha
  fin
areas
  cuadrante: AreaPC(2,2,15,15)
  areaFisc: AreaP (1,1,1,1)
  areaDeposito20: AreaPC (1,20,100,20)
  areaDeposito21: AreaPC (1,21,100,21)
robots
  robot robot1
  variables
    flores,av,ca:numero
    miID:numero
  comenzar
    flores:=0
    RecibirMensaje(miID,rF)
    recorrerF(flores)
    ladoColisionR1(flores,5,8)
    ladoColisionR1(flores,8,5)
    recorrerF(flores)
    EnviarMensaje(miID,rF)
    RecibirMensaje(ca,rF)
    av:=1
    Pos(av,ca)
    derecha
    mientras(ca < 99)&(HayFlorEnLaBolsa)
      depositarFlor
      mover
  fin
  robot robot2
  variables 
    cant:numero
    miID,ca,av:numero
  comenzar
    cant:=0
    RecibirMensaje(miID,rF)
    ladoColision58(cant)
    recorrerFyPlado2y3(cant)
    ladoColision85(cant)
    EnviarMensaje(miID,rF) 
    RecibirMensaje(ca,rF)
    av:=1
    Pos(av,ca)
    derecha
    mientras(ca < 99)&(HayFlorEnLaBolsa)&(HayPapelEnLaBolsa)
      depositarFlor
      depositarPapel
      mover
  fin
  robot robotFiscal
  variables
    miID:numero
    ca:numero
  comenzar
    ca:=20
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    RecibirMensaje(miID,*)
    si miID=1
      EnviarMensaje(ca,r1)
    sino
      si miID=2
        EnviarMensaje(ca,r2)
    RecibirMensaje(miID, *)
    ca:= ca+1
    si miID=1
      EnviarMensaje(ca,r1)
    sino
      si miID=2
        EnviarMensaje(ca,r2)
  fin
variables
  r1: robot1
  r2: robot2
  rF: robotFiscal
comenzar
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(rF, areaFisc)
  AsignarArea(r1, areaDeposito20)
  AsignarArea(r2, areaDeposito20)
  AsignarArea(r1, areaDeposito21)
  AsignarArea(r2, areaDeposito21)
  Iniciar(r1, 2,2)
  Iniciar(r2, 5,5)
  Iniciar(rF,1,1)
fin