programa ej1p3
procesos
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras HayFlorEnLaEsquina
      tomarFlor
      flores:=flores+1
  fin
  proceso juntarPapeles(ES papeles:numero)
  comenzar
    mientras HayPapelEnLaEsquina
      tomarPapel
      papeles:=papeles+1
  fin
  proceso depositarPapeles(E papeles:numero)
  comenzar
    repetir papeles
      depositarPapel
  fin
  proceso depositarFlores(E flores:numero)
  comenzar
    repetir flores
      depositarFlor
  fin
  proceso ingresoAEsquinaF(ES flores: numero)
  variables
    av,ca,avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    repetir 5
      Random(av,1,5)
      Random(ca,1,10)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      juntarFlores(flores)
      Pos(avIni,caIni)
      LiberarEsquina(av,ca) 
  fin
  proceso ingresoAEsquinaP(ES papeles: numero)
  variables
    av,ca,avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    repetir 3
      Random(av,1,5)
      Random(ca,1,10)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      juntarPapeles(papeles)
      Pos(avIni,caIni)
      LiberarEsquina(av,ca)
  fin
areas
  areaFlo: AreaPC (1,1,5,10)
  areaPap: AreaPC (6,1,10,9)
  area1: AreaP(6,10,6,10)
  area2:AreaP(7,10,7,10)
  area3: AreaP (8,10,8,10)
  area4: AreaP(9,10,9,10)
  areaEsq: AreaC(10,10,10,10)
robots
  robot rflorero
  variables
    flores,inicioAv,inicioCa:numero
  comenzar 
    inicioAv:= PosAv
    inicioCa:= PosCa
    flores:=0
    ingresoAEsquinaF(flores)
    BloquearEsquina(10,10)
    Pos(10,10)
    depositarFlores(flores)
    Pos(inicioAv,inicioCa)
    LiberarEsquina(10,10)
  fin
  robot rpapelero
  variables
    papeles,inicioAv,inicioCa:numero
  comenzar
    inicioAv:= PosAv
    inicioCa:= PosCa
    papeles:=0
    ingresoAEsquinaP(papeles)
    BloquearEsquina(10,10)
    Pos(10,10)
    depositarPapeles(papeles)
    Pos(inicioAv,inicioCa)
    LiberarEsquina(10,10)
  fin
variables
  rf1: rflorero
  rf2: rflorero
  rp1: rpapelero
  rp2: rpapelero
comenzar
  AsignarArea(rf1, areaFlo)
  AsignarArea(rf2, areaFlo)
  AsignarArea(rp1, areaPap)
  AsignarArea(rp1, areaPap)
  AsignarArea(rf1,areaEsq)
  AsignarArea(rf2,areaEsq)
  AsignarArea(rp1,areaEsq)
  AsignarArea(rp2,areaEsq)
  AsignarArea(rf1, area1)
  AsignarArea(rf2, area2)
  AsignarArea(rp1, area3)
  AsignarArea(rp2, area4)
  Iniciar(rf1, 6,10)
  Iniciar(rf2, 7,10)
  Iniciar(rp1, 8,10)
  Iniciar(rp2, 9,10)
fin 