programa parcialetapasrecolectores
procesos
  proceso enviarId
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso juntarFlores (ES flores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso juntarPapeles
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
  fin
  proceso segundaEtapa(E av:numero; E ca:numero)
  comenzar
    Pos(av,ca)
    repetir 9
      juntarPapeles
      mover
    juntarPapeles
  fin
  proceso primeraEtapa ( ES flores:numero)
  comenzar
    flores:=0
    repetir 9
      juntarFlores(flores)
      mover    
    juntarFlores(flores)
  fin
  proceso enviarIDmin(E idMin:numero)
  comenzar
    EnviarMensaje(idMin,r1)
    EnviarMensaje(idMin,r2)
    EnviarMensaje(idMin,r3)
  fin
areas
  area1: AreaP(5,1,5,10)
  area2: AreaP(6,1,6,10)
  area3: AreaP(7,1,7,10)
  areacoord:AreaP(1,1,1,1)
robots
  robot recolector1
  variables
    miId,idMin:numero
    flores:numero
  comenzar
    RecibirMensaje(miId,rcoord)
    primeraEtapa(flores)
    EnviarMensaje(miId,rcoord)
    EnviarMensaje(flores,rcoord)
    RecibirMensaje(idMin,rcoord)
    si (idMin<>miId)
      segundaEtapa(5,1)
      EnviarMensaje(miId,rcoord)
  fin
  robot recolector2
  variables
    flores:numero
    miId,idMin:numero
  comenzar    
    RecibirMensaje(miId,rcoord)
    primeraEtapa(flores)
    EnviarMensaje(miId,rcoord)
    EnviarMensaje(flores,rcoord)  
    RecibirMensaje(idMin,rcoord)
    si (idMin<>miId)
      segundaEtapa(6,1)
      EnviarMensaje(miId,rcoord)
  fin
  robot recolector3
  variables
    flores:numero
    miId,idMin:numero
  comenzar
    RecibirMensaje(miId,rcoord)
    primeraEtapa(flores)
    EnviarMensaje(miId,rcoord)
    EnviarMensaje(flores,rcoord)
    RecibirMensaje(idMin,rcoord)
    si (idMin<>miId)
      segundaEtapa(7,1)
      EnviarMensaje(miId,rcoord)
  fin
  robot coordinador
  variables
    fmin,idMin,idWin:numero
    id1,id2,id3,id:numero
    flores:numero
    ok:boolean
  comenzar
    fmin:=999
    enviarId
    repetir 3
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flores,r1)
      sino
        si(id=2)
          RecibirMensaje(flores,r2)
        sino
          RecibirMensaje(flores,r3)
      si (flores<fmin)
        fmin:=flores
        idMin:=id
    enviarIDmin(idMin)
    RecibirMensaje(id,*)
    idWin:=id
    Informar(idWin)
    RecibirMensaje(id,*)
  fin
variables
  r1:recolector1
  r2:recolector2
  r3:recolector3
  rcoord:coordinador
comenzar
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(rcoord,areacoord)
  Iniciar(r1,5,1)
  Iniciar(r2,6,1)
  Iniciar(r3,7,1)
  Iniciar(rcoord,1,1)
fin