programa valen
procesos
  proceso juntarTodasServidor (ES flores:numero)
  comenzar
    BloquearEsquina(5,5)
    Pos(5,5)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
    Pos(5,1)
    LiberarEsquina(5,5)
  fin
  proceso enviarEsq (E id:numero)
  variables
    av,ca:numero
  comenzar
    si(id=1)
      Random(av,10,30)
      Random(ca,10,30)
      EnviarMensaje(av,r1)
      EnviarMensaje(ca,r1)
    sino 
      si(id=2)
        Random(av,10,30)
        Random(ca,10,30)
        EnviarMensaje(av,r2)
        EnviarMensaje(ca,r2)       
      sino
        Random(av,10,30)
        Random(ca,10,30)
        EnviarMensaje(av,r3)
        EnviarMensaje(ca,r3)
  fin
  proceso depositarFlores (ES flores:numero; E av:numero; E ca:numero)
  comenzar
    BloquearEsquina(5,5)
    Pos(5,5)
    depositarFlor
    flores:=flores-1
    Pos(av,ca)
    LiberarEsquina(5,5)
  fin
  
  proceso juntarFlores(ES flores:numero; E av:numero ; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
    mientras(flores>0)
      depositarFlores(flores,av,ca)
    Pos(avIni,caIni)
    LiberarEsquina(av,ca)
  fin
  proceso enviarId
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
areas
  cuadrante:AreaPC(10,10,30,30)
  area1:AreaP(1,1,1,1)
  area2:AreaP(2,1,2,1)
  area3:AreaP(3,1,3,1)
  esq:AreaPC(5,5,5,5)
  areasv:AreaP(5,1,5,1)
robots
  robot floreros
  variables
    yo:numero
    int:numero
    av,ca:numero
    flores:numero
  comenzar
    flores:=0
    RecibirMensaje(yo,sv)
    Random(int,2,5)
    repetir int
      EnviarMensaje(yo,sv)
      RecibirMensaje(av,sv)
      RecibirMensaje(ca,sv)
      juntarFlores(flores,av,ca)
      EnviarMensaje(F,sv)
    EnviarMensaje(V,sv)
  fin
  robot servidor
  variables
    avRandom,caRandom:numero
    int:numero
    id:numero
    flores:numero
    ok1,ok2,ok3:boolean
    terminados:numero
    term:boolean
  comenzar
    flores:=0
    terminados:=0
    enviarId
    mientras(terminados<>3)
      RecibirMensaje(id,*)
      enviarEsq(id)
      RecibirMensaje(term,*)
      si(term)
        terminados:=terminados+1 
    juntarTodasServidor(flores)
    Informar(flores)
  fin
variables
  r1,r2,r3:floreros
  sv:servidor
comenzar
  AsignarArea(r1,cuadrante)
  AsignarArea(r2,cuadrante)
  AsignarArea(r3,cuadrante)
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(r1,esq)
  AsignarArea(r2,esq)
  AsignarArea(r3,esq)
  AsignarArea(sv,esq)
  AsignarArea(sv,areasv)
  Iniciar(r1,1,1)
  Iniciar(r2,2,1)
  Iniciar(r3,3,1)
  Iniciar(sv,5,1) 
fin