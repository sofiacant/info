  AsignarArea(r3,cuadrante)
  AsignarArea(r3,area3)
  AsignarArea(rf, areafisc)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,1)
  Iniciar(r3, 3,1)
  Iniciar(rf, 9,9)
fin