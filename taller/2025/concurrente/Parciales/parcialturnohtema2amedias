programa ejemplo
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso vaciarEsquina(E avIni:numero; E av:numero; E ca:numero)
  comenzar
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras (HayFlorEnLaEsquina)
      tomarFlor
    Pos(avIni,1)
    LiberarEsquina(av,ca)
  fin
  proceso enviarEsquina(E id:numero)
  variables
    av,ca:numero
  comenzar
    Random(av,10,30)
    Random(ca,10,30)
    si (id = 1)
      EnviarMensaje(av,r1)
      EnviarMensaje(ca,r1)
    sino
      si (id=2)
        EnviarMensaje(av,r2)
        EnviarMensaje(ca,r2)
      sino
        EnviarMensaje(av,r3)
        EnviarMensaje(ca,r3)   
  fin
  proceso inicializar(ES cont:numero;E cantTotal:numero; ES ok1:boolean; ES ok2:boolean; ES ok3:boolean)
  comenzar
    cont:=0
    cantTotal:=0
    ok1:=V
    ok2:=V
    ok3:=V
  fin
areas
  cuadrante: AreaPC (10,10,30,30)
  area1: AreaP(1,1,1,1)
  area2: AreaP(2,1,2,1)
  area3: AreaP(3,1,3,1)
  areafisc: AreaP(9,9,9,9)
robots
  robot rflorero
  variables
    avIni:numero
    int:numero
    id:numero
  comenzar
    avIni:=PosAv  
    Random(int,2,5)
    RecibirMensaje(id,rf)
    EnviarMensaje(id,rf)
    repetir int    
      RecibirMensaje(av,rf)   
      RecibirMensaje(ca,rf) 
      vaciarEsquina(avIni,av,ca)
      Enviar(int,rf)
    EnviarMensaje(F,rf)
  fin
  robot rfiscal
  variables
    av,ca:numero
    id:numero
    cont:numero
    cantTotal:numero
    ok1,ok2,ok3:boolean
  comenzar
    inicializar(cont,cantTotal,ok1,ok2,ok3)
    enviarIDs
    RecibirMensaje(id,*)
    mientras(ok1)&(ok2)&(ok3)
      enviarEsquina(id)
      RecibirMensaje(id,*)
      
    repetir 3
      RecibirMensaje(int,*)
      cantTotal:=cantTotal+int
      Informar('Total de intentos', cantTotal)
  fin
variables
  r1,r2,r3: rflorero
