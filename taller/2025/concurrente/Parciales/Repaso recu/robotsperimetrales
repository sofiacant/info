programa parcialperimetrales
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso enviarPerdedores(E idMax:numero)
  comenzar
    si(idMax=1)
      EnviarMensaje(0,r1)
      EnviarMensaje(2,r2)
      EnviarMensaje(3,r3)
    sino
      si(idMax=2)
        EnviarMensaje(0,r2)
        EnviarMensaje(1,r1)
        EnviarMensaje(3,r3)
      sino
        EnviarMensaje(0,r3)
        EnviarMensaje(2,r2)
        EnviarMensaje(1,r1)
  fin
  proceso actualizarMax(E flores:numero;ES fMax:numero;E id:numero; ES idMax:numero)
  comenzar
    si(flores> fMax)
      fMax:=flores
      idMax:=id
  fin
  proceso enviarTamanios
  variables
    tam:numero
  comenzar
    Random(tam,1,9)  
    EnviarMensaje(tam,r1)
    Random(tam,1,9)  
    EnviarMensaje(tam,r2)
    Random(tam,1,9)  
    EnviarMensaje(tam,r3)
  fin
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso hacerPerimetro(E per: numero; ES flores:numero)
  comenzar
    repetir per-1
      juntarFlores(flores)
      mover
    juntarFlores(flores)
  fin
  proceso depositarFlores31(ES flores:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    BloquearEsquina(31,2)
    Pos(31,2)
    depositarFlor
    flores:=flores-1
    Pos(av,ca)
    LiberarEsquina(31,2)
  fin
areas
  area1: AreaP (1,1,10,10)
  area2: AreaP (11,1,20,10)
  area3: AreaP (21,1,30,10)
  areajefe: AreaP (31,1,31,1)
  areadeposito: AreaPC (31,2,31,2)
robots
  robot perimetral1
  variables
    miId:numero
    tam:numero
    flores:numero
    num:numero
    ok1,ok2:boolean
  comenzar
    flores:=0
    RecibirMensaje(miId,rjefe)
    RecibirMensaje(tam,rjefe)
    hacerPerimetro(tam,flores)
    EnviarMensaje(miId,rjefe)
    EnviarMensaje(flores,rjefe)
    RecibirMensaje(num,rjefe)
    si (num=miId)
      repetir flores
        depositarFlores31(flores)
    EnviarMensaje(V,r2)
    EnviarMensaje(V,r3)
    repetir 2
      RecibirMensaje(ok1,*)
    si(ok1)
      derecha
      hacerPerimetro(tam,flores)
      
  fin
  robot perimetral2
  variables
    miId:numero
    tam:numero
    flores:numero
    num:numero
    ok1,ok2:boolean
  comenzar
    flores:=0
    RecibirMensaje(miId,rjefe)
    RecibirMensaje(tam,rjefe)
    hacerPerimetro(tam,flores)
    EnviarMensaje(miId,rjefe)
    EnviarMensaje(flores,rjefe)
    RecibirMensaje(num,rjefe)
    si (num=miId)
      repetir flores
        depositarFlores31(flores)
    EnviarMensaje(V,r1)
    EnviarMensaje(V,r2)
    repetir 2
      RecibirMensaje(ok1,*)
    si(ok1) 
      derecha
      hacerPerimetro(tam,flores)
  fin
  robot perimetral3
  variables
    miId:numero
    tam:numero
    flores:numero
    num:numero
    ok1,ok2:boolean
  comenzar
    flores:=0
    RecibirMensaje(miId,rjefe)
    RecibirMensaje(tam,rjefe)
    hacerPerimetro(tam,flores)
    EnviarMensaje(miId,rjefe)
    EnviarMensaje(flores,rjefe)
    RecibirMensaje(num,rjefe)
    si(num = miId)
      repetir flores
        depositarFlores31(flores)
    EnviarMensaje(V,r1)
    EnviarMensaje(V,r2)
    repetir 2
      RecibirMensaje(ok1,*)
    si(ok1)
      derecha
      hacerPerimetro(tam,flores)   
  fin
  robot robotJefe
  variables
    flores,fMax:numero 
    id,idMax:numero
  comenzar
    fMax:=-1
    idMax:=-1
    enviarIDs
    enviarTamanios
    repetir 3
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flores,r1)
      sino
        si (id=2)
          RecibirMensaje(flores,r2)
        sino
          RecibirMensaje(flores,r3)
      actualizarMax(flores,fMax,id,idMax)
    Informar('El ganador',idMax)
    enviarPerdedores(idMax)
  fin
variables
  r1: perimetral1
  r2: perimetral2
  r3: perimetral3
  rjefe:robotJefe
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(r1,areadeposito)
  AsignarArea(r2,areadeposito)
  AsignarArea(r3,areadeposito)
  AsignarArea(rjefe,areajefe) 
  Iniciar(r1, 1,1)
  Iniciar(r2, 11,1)
  Iniciar(r3,21,1)
  Iniciar(rjefe,31,1)
fin