programa ej4p2
procesos
  proceso recolectar(ES cant:numero)
  comenzar
    mientras HayFlorEnLaEsquina
      tomarFlor
      cant:=cant+1
    mientras HayPapelEnLaEsquina
      tomarPapel
      cant:=cant+1
  fin
  proceso ingresoAlArea(ES cant:numero)
  variables
    av,ca,avInic,caInic:numero
  comenzar
    avInic:=PosAv
    caInic:= PosCa
    Random(av,25,75)
    Random(ca,25,75)
    Pos(av,ca)
    recolectar(cant)
    Pos(avInic,caInic)
  fin
  proceso inicializarCant(ES cant1:numero ; ES cant2:numero ; ES cant3:numero ; ES cant4:numero)
  comenzar
    cant1:=0
    cant2:=0
    cant3:=0    
    cant4:=0
  fin
  proceso obtenerMaximo(E cant1:numero ;E cant2:numero ;E cant3:numero ;E cant4:numero; ES maxR:numero)
  variables
    maxCant:numero
  comenzar
    maxCant:=-1
    si (cant1 > maxCant)
      maxCant:=cant1
      maxR:=1
    si (cant2 > maxCant)
      maxCant:=cant2
      maxR:=2
    si (cant3 > maxCant)
      maxCant:=cant3
      maxR:=3
    si (cant4 > maxCant)
      maxCant:=cant4
      maxR:=4
  fin
  proceso avisarGanador(E id:numero; E ok:boolean) 
  comenzar
    si id = 1
      EnviarMensaje(V,r1)
      EnviarMensaje(F,r2)
      EnviarMensaje(F,r3)
      EnviarMensaje(F,r4)
      EnviarMensaje(50,r1)
      EnviarMensaje(50,r1)
    sino
      si id = 2
        EnviarMensaje(V,r2)
        EnviarMensaje(F,r1)
        EnviarMensaje(F,r3)
        EnviarMensaje(F,r4)
        EnviarMensaje(50,r2)
        EnviarMensaje(50,r2)
      sino
        si id = 3
          EnviarMensaje(V,r3)
          EnviarMensaje(F,r1)
          EnviarMensaje(F,r2)
          EnviarMensaje(F,r4)
          EnviarMensaje(50,r3)
          EnviarMensaje(50,r3)
        sino
          si id = 4
            EnviarMensaje(V,r4)
            EnviarMensaje(F,r1)
            EnviarMensaje(F,r2)
            EnviarMensaje(F,r3)
            EnviarMensaje(50,r4)
            EnviarMensaje(50,r4)
            
  fin
areas
  cuadrante: AreaPC (25,25,75,75)
  areaF: AreaP (1,1,1,1)
  areaR1: AreaP (25,1,25,1)
  areaR2: AreaP (30,1,30,1) 
  areaR3: AreaP (35,1,35,1)
  areaR4: AreaP (40,1,40,1)
robots
  robot rRecolector
  variables
    puede,gane:boolean
    cant,av,ca:numero
  comenzar
    cant:=0
    RecibirMensaje(puede,rFisc)
    mientras(puede = V) 
      ingresoAlArea(cant)
      EnviarMensaje(cant,rFisc)
      RecibirMensaje(puede,rFisc)      
    RecibirMensaje(gane,rFisc)
    si (gane)  
      RecibirMensaje(av,rFisc)
      RecibirMensaje(ca,rFisc)
      Pos(av,ca)
  fin
  robot rFiscal
  variables
    cant1,cant2,cant3,cant4:numero
    id,maxR:numero
    puede,termino,ok:boolean
    win:numero
  comenzar
    inicializarCant(cant1,cant2,cant3,cant4)
    repetir 10
      Random(id,1,4) 
      si id = 1
        EnviarMensaje(V,r1)
        RecibirMensaje(cant1,r1)
      sino
        si id = 2
          EnviarMensaje(V,r2)
          RecibirMensaje(cant2,r2)     
        sino
          si id = 3
            EnviarMensaje(V,r3)
            RecibirMensaje(cant3,r3) 
          sino
            si id= 4
              EnviarMensaje(V,r4)
              RecibirMensaje(cant4,r4)
    EnviarMensaje(F,r1)
    EnviarMensaje(F,r2)
    EnviarMensaje(F,r3)
    EnviarMensaje(F,r4)
    obtenerMaximo(cant1,cant2,cant3,cant4,maxR)
    Informar(maxR)
    avisarGanador(maxR,ok)  
  fin
variables
  r1,r2,r3,r4:rRecolector
  rFisc: rFiscal
comenzar
  AsignarArea(r1,cuadrante)
  AsignarArea(r2,cuadrante)
  AsignarArea(r3,cuadrante)
  AsignarArea(r4,cuadrante)
  AsignarArea(r1,areaR1)
  AsignarArea(r2,areaR2)
  AsignarArea(r3,areaR3)
  AsignarArea(r4,areaR4)
  AsignarArea(rFisc,areaF)
  Iniciar(rFisc, 1,1)
  Iniciar(r1, 25,1)
  Iniciar(r2, 30,1)
  Iniciar(r3, 35,1)
  Iniciar(r4,40,1)
fin
