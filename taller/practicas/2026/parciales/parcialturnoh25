programa ejturnoh
procesos
  proceso enviarIDS
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso enviarTamaños
  variables
    tam:numero
  comenzar
    Random(tam,1,6)
    EnviarMensaje(tam, r1)
    Random(tam,1,6)
    EnviarMensaje(tam, r2)
    Random(tam,1,6)
    EnviarMensaje(tam, r3)
  fin
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso cuadrado(ES flores:numero; E tam:numero)
  comenzar
    repetir 4
      repetir tam
        juntarFlores(flores)
        mover
      juntarFlores(flores)
      derecha
  fin
  proceso hacerCuadrados(ES flores:numero; E tam:numero; E id:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    repetir 3
      cuadrado(flores,tam)
      repetir flores
        depositar50(flores)     
      EnviarMensaje(id,rc)
      EnviarMensaje(flores,rc)
      ca:=ca+tam+1
      Pos(av,ca)
  fin
  proceso depositar50(E flores:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    BloquearEsquina(50,50)
    Pos(50,50)
    si(HayFlorEnLaBolsa){no deberia ir, pero para que no se rompa}
      depositarFlor
    Pos(av,ca)
    LiberarEsquina(50,50)  
  fin
  proceso juntarFloresCoord(E flores:numero)
  comenzar
    repetir flores
      BloquearEsquina(50,50)
      Pos(50,50)
      si(HayFlorEnLaEsquina){no deberia ir, pero para que no se rompa}
        tomarFlor
      Pos(100,100)
      LiberarEsquina(50,50)  
  fin
  proceso calcularMax(E f1:numero; E f2:numero; E f3:numero; ES fMax:numero; ES rMax:numero)
  comenzar
    si(f1>f2)&(f1>f3)
      fMax:=f1
      rMax:=1
    sino
      si(f2>f1)&(f2>f3)
        fMax:=f2
        rMax:=2
      sino
        si(f3>f1) & (f3>f2)
          fMax:=f3
          rMax:=3
  fin
areas
  areaCoord: AreaP (100,100,100,100)
  esquina50: AreaC (50,50,50,50)
  area1: AreaP (1,1,7,21)
  area2: AreaP (10,1,17,21)
  area3: AreaP (20,1,27, 21)
robots
  robot recolector
  variables
    id,flores,tam:numero
  comenzar
    flores:=0
    RecibirMensaje(id,rc)
    RecibirMensaje(tam,rc)
    hacerCuadrados(flores,tam,id)
    EnviarMensaje(V,rc)    
  fin
  robot coordinador
  variables
    id,tam,rMax:numero
    flores,f1,f2,f3,fMax:numero
    ok:boolean
  comenzar
    fMax:=-1
    rMax:=-1
    enviarIDS
    enviarTamaños
    repetir 9
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flores,r1)
        f1:=f1+flores
        juntarFloresCoord(flores)
      sino
        si(id=2)
          RecibirMensaje(flores,r2)
          f2:=f2+flores
          juntarFloresCoord(flores)
        sino
          RecibirMensaje(flores,r3)
          f3:=f3+flores
          juntarFloresCoord(flores)
    repetir 3
      RecibirMensaje(ok,*)
    calcularMax(f1,f2,f3,fMax,rMax)
    Informar('El que junto mas flores fue',rMax)
  fin
variables
  r1,r2,r3: recolector
  rc:coordinador
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r1,esquina50)
  AsignarArea(r2, area2)
  AsignarArea(r2,esquina50)
  AsignarArea(r3, area3)
  AsignarArea(r3,esquina50)
  AsignarArea(rc,areaCoord)
  AsignarArea(rc, esquina50)
  Iniciar(rc, 100,100)
  Iniciar(r1, 1,1)
  Iniciar(r2, 10,1)
  Iniciar(r3, 20,1)
fin