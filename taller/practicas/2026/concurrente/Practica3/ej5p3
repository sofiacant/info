{5- Realice un programa en el que 4 robots juegan una carrera por avenidas diferentes: 4, 6, 8 y 10 respectivamente. Todos los robots inician en la calle 1. Para poder avanzar, cada robot debe juntar un papel de una fuente de papeles localizada en la esquina (11,11), colocarlo en la esquina actual de su avenida y avanzar un paso. Cuando la esquina fuente ya no tiene más papeles, o cuando se haya completado la avenida, deberán avisar al robot coordinador y este determinará el robot que llegó más lejos. }

programa ejemplo
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)    
    EnviarMensaje(4,r4)
  fin
  proceso carrera(ES ok:boolean; E id:numero)
  variables
    avIni,caIni:numero
    ca:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(11,11)
    Pos(11,11)
    si (HayPapelEnLaEsquina)
      tomarPapel
    sino
      ok:=F
    Pos(avIni,caIni)
    LiberarEsquina(11,11)
  fin
areas
  fuente: AreaPC(11,11,11,11)
  areaCoord: AreaP (1,1,1,1)
  area1: AreaP (4,1,4,1)
  area2: AreaP (6,1,6,1)
  area3: AreaP (8,1,8,1)
  area4: AreaP (10,1,10,1)
robots
  robot robot1
  variables
    id:numero
    ok:boolean
  comenzar
    RecibirMensaje(id,rc)
    ok:=V
    mientras(ok)& (PosCa<100)
      carrera(ok,id)
      si (ok)
        depositarPapel
        mover
    ca:=PosCa
    EnviarMensaje(id,rc)
    EnviarMensaje(ca,rc)
  fin
  robot coordinador
  variables
    id,idMax:numero
    caMax,ca:numero
  comenzar
    enviarIDs
    caMax:=-1
    idMax:=-1
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(ca,r1)
      sino
        si(id=2)
          RecibirMensaje(ca,r2)
        sino
          si(id=3)
            RecibirMensaje(ca,r3)
          sino
            RecibirMensaje(ca,r4)
      si(ca>caMax)
        caMax:= ca
        idMax:=id
    Informar(idMax)   
  fin
variables
  r1,r2,r3,r4: robot1
  rc:coordinador
comenzar
  AsignarArea(r1, fuente)
  AsignarArea(r2, fuente)
  AsignarArea(r3, fuente)
  AsignarArea(r4, fuente)
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(r4,area4)
  AsignarArea(rc,areaCoord)
  Iniciar(rc, 1,1)
  Iniciar(r1, 4,1)
  Iniciar(r2, 6,1)
  Iniciar(r3, 8,1)
  Iniciar(r4, 10,1)
fin