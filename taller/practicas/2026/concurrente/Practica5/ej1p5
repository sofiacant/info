programa ej1p5
procesos
  proceso enviarIDS
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,a1)
    EnviarMensaje(4,a2)
  fin
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flor:=flor+1
  fin
  proceso juntarPapeles(ES papeles:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papel:=papel+1
  fin
  proceso primerRecorridoF(ES flores:numero)
  comenzar
    repetir 96
      juntarFlores(flores)
      mover
    juntarFlores(flores)    
  fin
  proceso primerRecorridoP(ES papeles:numero)
  comenzar
    repetir 96
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)    
  fin
  proceso ultimoTramoF(ES flores:numero; E av:numero; ES ca:numero)
  comenzar
    ca:=ca+1
    BloquearEsquina(av,ca)
    Pos(av,ca)
    juntarFlores(flores)
    mover
    LiberarEsquina(av,ca){corregir porq hay dos esquinas}
    ca:=ca+1
    juntarFlores(flores)
  fin
  proceso ultimoTramoP(ES papeles:numero; E av:numero)
  comenzar
    
  fin
  
areas
  esquina: AreaPC (2,98,3,99)
  area1: AreaP (2,1,2,97)
  area2: AreaP (3,1,3,97)
  ult2: AreaP (2,100,2,100)
  ult3: AreaP(3,100,3,100)
  area3: AreaP (1,98,100,98)
  area4: AreaP (1,99,100,99)
  areaFiscal: AreaP(1,1,1,1)
robots
  robot robot1
  variables
    id,flores:numero
  comenzar
    flores:=0 
    RecibirMensaje(id,rf)
    primerRecorridoF(flores)
  fin
  robot robot2
  variables
    id,papeles:numero
  comenzar
    papeles:=0
    derecha
    RecibirMensaje(id,rf)
    primerRecorridoP(papeles)
  fin
  robot fiscal
  variables
    flores,papeles:numero
  comenzar
    flores:=0
    papeles:=0
    enviarIDS
  fin
variables
  r1,r2: robot1
  a1,a2:robot2
  rf:fiscal
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r2,area2)
  AsignarArea(a1,area3)
  AsignarArea(a2,area4)
  AsignarArea(rf,areaFiscal)
  AsignarArea(r1,esquina)
  AsignarArea(r2,esquina)
  AsignarArea(a1,esquina)  
  AsignarArea(a2,esquina)
  AsignarArea(r1,ult2)
  AsignarArea(r2,ult3)
  Iniciar(r1, 2,1)
  Iniciar(r2, 3,1)
  Iniciar(a1,1,98)
  Iniciar(a2,1,99)
  Iniciar(rf,1,1)
fin