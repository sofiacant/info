{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso limpiarFlores
  comenzar
    mientras HayFlorEnLaEsquina
      tomarFlor
  fin
  proceso limpiarPapeles
  comenzar
    mientras HayPapelEnLaEsquina
      tomarPapel
  fin
  proceso recorrerCalleFlor
  comenzar
    repetir 99
      limpiarFlores
      mover
    limpiarFlores
  fin
  proceso recorrerCallePapel
  comenzar
    repetir 99
      limpiarPapeles
      mover
    limpiarPapeles
  fin
  proceso recorrerAvenidasPares
  variables
    av:numero
  comenzar
    av:=PosAv
    repetir 24
      recorrerCallePapel
      av:=av+1
      Pos(av,1)
    recorrerCallePapel
  fin
  proceso recorrerAvenidasImpares
  variables
    av:numero
  comenzar
    av:=PosAv
    repetir 24
      recorrerCalleFlor
      av:= av+1
      Pos(av,1)
    recorrerCalleFlor
  fin
areas
  area1: AreaP (1,1,25,100)
  area2: AreaP (26,1,50,100)
  area3: AreaP (51,1,75,100)
  area4: AreaP (76,1,100,100)
robots
  robot robot1
  comenzar
    recorrerAvenidasImpares
    Pos(51,1)
    recorrerAvenidasImpares
  fin
  robot robot2
  comenzar
    recorrerAvenidasPares
    Pos(76,1)
    recorrerAvenidasPares
  fin
variables
  rimpar: robot1
  rpar:robot2
comenzar
  AsignarArea(rimpar, area1)
  AsignarArea(rpar, area2)
  AsignarArea(rimpar, area3) 
  AsignarArea(rpar, area4)
  Iniciar(rimpar,1,1)
  Iniciar(rpar,26,1)
fin