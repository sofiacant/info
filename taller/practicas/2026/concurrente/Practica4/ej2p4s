{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso juntarPapelesYDepositar(ES papeles:numero)
  variables
    av,ca:numero
  comenzar
    mientras(papeles<5)
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        papel:=papel+1
      si (papeles < 5)
        mover
    si(papeles=5)
      av:=PosAv
      ca:=PosCa
      BloquearEsquina(50,50)
      Pos(50,50)
      repetir papeles
        depositarPapel
      Pos(av,ca)
      LiberarEsquina(50,50)
  fin
areas
  esquina50: AreaC (50,50,50,50)
  areap1: AreaP(5,1,5,100)
  areap2: AreaP(10,1,10,100)
  areac1: AreaP(11,1,11,100)
  areac2: AreaP(12,1,12,100)
robots
  robot consumidor
  comenzar
    recorrerAvenida(1)
  fin
  robot productor
  comenzar
    recorrerAvenida(1)
  fin
variables
  c1,c2: consumidor
  p3,p4: productor
comenzar
  AsignarArea(p1, esquina50)
  AsignarArea(p2, esquina50)
  AsignarArea(c1, esquina50)  
  AsignarArea(c2, esquina50)
  AsignarArea(p1,areap1)
  AsignarArea(p2,areap2)
  AsignarArea(c1,areac1)
  AsignarArea(c2,areac2)
  Iniciar(c1,11,1)
  Iniciar(c2,12,1)
  Iniciar(p1,5,1)
  Iniciar(p2,10,1)
fin