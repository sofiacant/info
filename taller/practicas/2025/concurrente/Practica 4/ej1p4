programa ej1p4
procesos
  proceso depositarFenEsquina(E av: numero;E ca:numero; ES flores:numero)
  comenzar
    Pos(av,ca)
    repetir flores
      depositarFlor
    Pos(100,100)
  fin
  proceso juntaryDepositar(E av: numero;E ca:numero)
  comenzar
    Pos(av,ca)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
    Pos(av,ca-1)
    mientras (HayFlorEnLaBolsa) & (ca < 100)
      depositarFlor  
      mover 
    si (HayFlorEnLaBolsa) & (ca=100)
      depositarFlor
       
  fin
areas
  areaServidor: AreaP (100,100,100,100)
  areaCliente1: AreaPC (1,1,1,100)
  areaCliente2: AreaPC (2,1,2,100)
  areaCliente3: AreaPC(3,1,3,100)
robots
  robot rCliente
  variables
    av,ca:numero
    id,flores:numero
    deposito:boolean
  comenzar
    RecibirMensaje(id,rServidor)
    mientras (PosCa < 99 )
      Random(flores,1,4)
      av:=PosAv 
      ca:=PosCa+1
      EnviarMensaje(id, rServidor)
      EnviarMensaje(flores,rServidor)
      EnviarMensaje(av,rServidor)
      EnviarMensaje(ca,rServidor)
      RecibirMensaje(deposito,rServidor)  
      juntaryDepositar(av,ca)
    EnviarMensaje(id, rServidor)
    EnviarMensaje(0, rServidor)
  fin
  robot rServidor
  variables
    flores,id,av,ca:numero
    fin1,fin2,fin3:boolean
  comenzar
    fin1:=V
    fin2:=V
    fin3:=V
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    mientras (fin1)|(fin2)|(fin3)
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flores,r1)
        si (flores<>0)
          RecibirMensaje(av,r1) 
          RecibirMensaje(ca,r1)
          depositarFenEsquina(av,ca,flores) 
          EnviarMensaje(V,r1)
        sino
          fin1:=F
      sino
        si(id=2)
          RecibirMensaje(flores,r2)
          si(flores<>0)
            RecibirMensaje(av,r2) 
            RecibirMensaje(ca,r2)
            depositarFenEsquina(av,ca,flores) 
            EnviarMensaje(V,r2)
          sino
            fin2:=F
        sino 
          RecibirMensaje(flores,r3)
          si (flores<>0)
            RecibirMensaje(av,r3) 
            RecibirMensaje(ca,r3)
            depositarFenEsquina(av,ca,flores,fin3) 
            EnviarMensaje(V,r3)
          sino
            fin3:=F
  fin     
variables
  r1: rCliente
  r2:rCliente
  r3:rCliente
  rServidor:rServidor
comenzar
  AsignarArea(r1, areaCliente1)
  AsignarArea(r2, areaCliente2)
  AsignarArea(r3, areaCliente3)
  AsignarArea(rServidor,areaServidor)
  AsignarArea(rServidor, areaCliente1)
  AsignarArea(rServidor,areaCliente2)
  AsignarArea(rServidor,areaCliente3)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,1)
  Iniciar(r3, 3,1)
  Iniciar(rServidor,100,100)
fin