programa ej1p5
procesos
  proceso juntarFlores(ES cant:numero)
  comenzar 
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cant:=cant+1
  fin
  proceso juntarPapeles(ES cant:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cant:=cant+1
  fin
  proceso enviarIds
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,a1)
    EnviarMensaje(4,a2)
  fin
  proceso recorrerAvenidaRojo(ES cant: numero)
  comenzar
    repetir 96
      juntarFlores(cant)
      mover
    juntarFlores(cant)
  fin
  proceso ultsEsquinasRojo(ES cant:numero; E av:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,98)
    Pos(av,98)
    juntarFlores(cant)
    Pos(avIni,caIni)
    LiberarEsquina(av,98)
    BloquearEsquina(av,99)
    repetir 2
      mover
    juntarFlores(cant)
    mover
    LiberarEsquina(av,99)
    juntarFlores(cant)  
  fin
  proceso primerasEsqAzul(ES cant:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    derecha
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(2,ca)
    Pos(2,ca)
    juntarPapeles(cant)
    Pos(avIni,caIni)
    LiberarEsquina(2,ca)
    BloquearEsquina(3,ca)
    repetir 2
      mover
    juntarPapeles(cant)
    mover
    LiberarEsquina(3,ca)
    juntarPapeles(cant)
  fin
  proceso recorrerAvenidaAzul(ES cant:numero)
  comenzar
    repetir 96
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        cant:=cant+1
      mover
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cant:=cant+1
  fin
  
areas
  areaRojo1: AreaPC (2,1,2,100)
  areaRojo2: AreaPC(3,1,3,100)
  areaAzul1: AreaPC(1,98,100,98)
  areaAzul2: AreaPC(1,99,100,99)
  areaFisc: AreaP (4,1,4,1)
robots
  robot robotRojo
  variables
    cant,id,av:numero
  comenzar
    cant:=0
    av:= PosAv
    RecibirMensaje(id,rf)  
    recorrerAvenidaRojo(cant)
    ultsEsquinasRojo(cant,av)
    EnviarMensaje(id,rf)
    EnviarMensaje(cant,rf) 
  fin
  robot robotAzul
  variables
    cant,id,ca:numero
  comenzar
    cant:=0
    ca:=PosCa
    RecibirMensaje(id,rf)
    primerasEsqAzul(cant,ca)
    recorrerAvenidaAzul(cant)
    EnviarMensaje(id,rf)
    EnviarMensaje(cant,rf) 
  fin
  robot rFiscalizador
  variables
    cantAzul,cantRojo,cant:numero
    id:numero
  comenzar
    cantAzul:=0
    cantRojo:=0
    enviarIds
    repetir 4
      RecibirMensaje(id,*)
      RecibirMensaje(cant,*)
      si (id = 1)|(id=2)
        cantRojo:= cantRojo+cant
      sino
        si (id=3)|(id=4)
          cantAzul:= cantAzul+cant
    si (cantAzul > cantRojo)
      Informar("Ganador equipo azul con ",cantAzul)
    sino
      Informar("Ganador equipo Rojo con ",cantRojo)
  fin
variables
  r1,r2: robotRojo
  a1,a2: robotAzul
  rf:rFiscalizador
comenzar
  AsignarArea(r1, areaRojo1)
  AsignarArea(r1, areaRojo2)
  AsignarArea(r2, areaRojo2)
  AsignarArea(r2, areaRojo1)
  AsignarArea(a1, areaAzul1)
  AsignarArea(a1, areaAzul2)
  AsignarArea(a2, areaAzul1)
  AsignarArea(a2, areaAzul2)
  AsignarArea(rf,areaFisc)
  Iniciar(r1, 2,1)
  Iniciar(r2, 3,1)
  Iniciar(a1, 1,98)
  Iniciar(a2, 1,99)
  Iniciar(rf,4,1)
fin