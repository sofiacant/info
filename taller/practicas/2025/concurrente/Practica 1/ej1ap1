programa ejemplo
procesos
  proceso juntarFlores(ES flores:numero ; ES esqSinFlores:numero)
  comenzar
    si HayFlorEnLaEsquina
      mientras HayFlorEnLaEsquina 
        tomarFlor
        flores:= flores+1
    sino    
      esqSinFlores:= esqSinFlores+1 
  fin  
  proceso depositarFlores(ES flores:numero)       
  comenzar 
    repetir flores
      depositarFlor
  fin
  proceso recorrerAvenida (ES flores:numero; ES esqSinFlores:numero)
  comenzar
    flores:=0
    esqSinFlores:=0  
    repetir 99
      juntarFlores(flores,esqSinFlores)
      mover
    juntarFlores(flores,esqSinFlores) 
    depositarFlores(flores)
    Informar('Flores', flores)
    Informar('Esquinas sin flores', esqSinFlores)
  fin  
areas
  ciudad: AreaP (1, 1,1,100)
  ciudad2: AreaP (3,1,3,100)
  ciudad3: AreaP (5,1,5,100)
robots
  robot robot1
  variables
    flores:numero
    esqSinFlores:numero
    avenida:numero
  comenzar
    avenida:=1
    repetir 2
      recorrerAvenida(flores, esqSinFlores)
      avenida:= avenida+2
      Pos(avenida,1)
    recorrerAvenida(flores, esqSinFlores)
  fin
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  AsignarArea(R_info, ciudad2)
  AsignarArea(R_info, ciudad3)  
  Iniciar(R_info, 1,1)
fin