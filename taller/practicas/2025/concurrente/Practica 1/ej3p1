programa ejemplo
procesos
  proceso juntarPapeles(ES cantP:numero)
  comenzar
    cantP:=0
    mientras HayPapelEnLaEsquina
      tomarPapel 
      cantP:= cantP + 1
    repetir cantP
      depositarPapel
  fin
  proceso juntarFlores(ES cantF:numero)
  comenzar
    cantF:=0
    mientras HayFlorEnLaEsquina
      tomarFlor 
      cantF:= cantF + 1
    repetir cantF
      depositarFlor
  fin 
  proceso subirEscalon(E cantR:numero; ES cantP:numero ; ES cantF:numero; ES cantEsc:numero)
  comenzar
    repetir cantR
      juntarPapeles(cantP)
      juntarFlores(cantF)
      mover
    derecha
    repetir cantR
      juntarPapeles(cantP)
      juntarFlores(cantF)
      mover
    cantR:=cantR+1
    repetir 3
      derecha
    si(cantP-cantF = 1)
      cantEsc:= cantEsc+1  
  fin
  proceso subirEscalera(ES cantR:numero; ES cantP:numero ; ES cantF:numero; ES cantEsc:numero)
  comenzar
    repetir 4
      subirEscalon(cantR,cantP,cantF,cantEsc)
  fin
areas
