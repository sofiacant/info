programa ejemplo
procesos
  proceso enviarIds
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin
  proceso vaciarBolsa
  comenzar
    mientras(HayFlorEnLaBolsa)
      depositarFlor
    mientras(HayPapelEnLaBolsa)
      depositarPapel
  fin

  proceso juntarFlor(ES flores:numero)
  comenzar
    si(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores+1
  fin
  proceso juntarPapeles(ES papeles:numero)
  comenzar
    si (HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles-1
  fin
  proceso recorrido(ES flores:numero)
  comenzar
    repetir 18
      juntarFlor(flores)
      mover
    juntarFlor(flores)
  fin
  proceso recorridoPapeles(ES papeles:numero)
  comenzar
    repetir 2
      derecha
    repetir 18
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)
  fin
  proceso depositodeauna(ES flores:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    BloquearEsquina(1,6)
    Pos(1,6)
    depositarFlor
    Pos(av,ca)
    LiberarEsquina(1,6)
  fin
  proceso depositoPapeles(ES papeles:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    BloquearEsquina(1,6)
    Pos(1,6)
    depositarPapel
    Pos(av,ca)
    LiberarEsquina(1,6)
  fin
  proceso buscarGanadores(E id:numero)
  comenzar
    si(id = 1)
      EnviarMensaje(V,r1)
    sino
      si(id=2)
        EnviarMensaje(V,r2)
      sino
        si(id=3)
          EnviarMensaje(V,r3)
        sino
          EnviarMensaje(V,r4)
  fin
  proceso buscarPerdedores(E id:numero)
  comenzar
    si(id = 1)
      EnviarMensaje(F,r1)
    sino
      si(id=2)
        EnviarMensaje(F,r2)
      sino
        si(id=3)
          EnviarMensaje(F,r3)
        sino
          EnviarMensaje(F,r4)
  fin
areas
  area1: AreaP (1,1,20,1)
  area2: AreaP (1,2,20,2)
  area3: AreaP (1,3,20,3)
  area4: AreaP (1,4,20,4)
  areafiscal: AreaP(1,5,1,5)
  areadeposito: AreaPC (1,6,1,6)
robots
  robot corredor1
  variables
    miId:numero
    caIni:numero
    flores,papeles:numero
    ok: boolean
  comenzar
    flores:=0
    papeles:=0
    caIni:=PosCa
    vaciarBolsa
    RecibirMensaje(miId,rf)
    derecha
    mover
    recorrido(flores)
    repetir flores
      depositodeauna(flores)
    EnviarMensaje(miId,rf)
    RecibirMensaje(ok,rf)
    si (ok=V)
      recorridoPapeles(papeles)
      repetir papeles
        depositoPapeles(papeles)
      EnviarMensaje(miId,rf) 
    Pos(1,caIni) 
  fin
