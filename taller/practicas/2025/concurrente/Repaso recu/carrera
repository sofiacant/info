  robot corredor3
  variables
    miId:numero
    caIni:numero
    flores,papeles:numero
    ok: boolean
  comenzar
    flores:=0
    papeles:=0
    caIni:=PosCa
    vaciarBolsa
    RecibirMensaje(miId,rf)
    derecha
    mover
    recorrido(flores)
    si(flores >0 )
      repetir flores
        depositodeauna(flores)
    EnviarMensaje(miId,rf)
    RecibirMensaje(ok,rf)
    si (ok=V)
      recorridoPapeles(papeles)
      si(papeles>0)
        repetir papeles
          depositoPapeles(papeles)
      EnviarMensaje(miId,rf) 
    Pos(1,caIni) 
  fin
  robot corredor4
  variables
    miId:numero
    caIni:numero
    flores,papeles:numero
    ok: boolean
  comenzar
    flores:=0
    papeles:=0
    caIni:=PosCa
    vaciarBolsa
    RecibirMensaje(miId,rf)
    derecha
    mover
    recorrido(flores)
    repetir flores
      depositodeauna(flores)
    EnviarMensaje(miId,rf)
    RecibirMensaje(ok,rf)
    si (ok=V)
      recorridoPapeles(papeles)
      si(papeles>0)
        repetir papeles
          depositoPapeles(papeles)
      EnviarMensaje(miId,rf) 
    Pos(1,caIni) 
  fin
  robot fiscalizador
  variables
    id,idwin:numero
    ok:numero
  comenzar
    enviarIds
    repetir 2
      RecibirMensaje(id, *)
      buscarGanadores(id)
    repetir 2
      RecibirMensaje(id, *)
      buscarPerdedores(id)   
    RecibirMensaje(id,*)
    idwin:=id
    RecibirMensaje(id,*)
    Informar('ganador segunda etapa',idwin)
  fin
variables
  r1:corredor1
  r2:corredor2
  r3:corredor3
  r4:corredor4
  rf:fiscalizador
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(r4, area4)
  AsignarArea(r1,areadeposito)
  AsignarArea(r2,areadeposito)
  AsignarArea(r3,areadeposito)
  AsignarArea(r4,areadeposito) 
  AsignarArea(rf,areafiscal)
  Iniciar(r1, 1,1)
  Iniciar(r2, 1,2)
  Iniciar(r3, 1,3)
  Iniciar(r4, 1,4)
  Iniciar(rf,1,5)
fin