programa ej3P2
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin 
  proceso juntarFlorEsquina(ES flor:numero; E av:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:= PosAv
    caIni:= PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras HayFlorEnLaEsquina
      tomarFlor
      flor:= flor+1
      Pos(avIni,caIni)
      LiberarEsquina(av,ca)
      BloquearEsquina(av,ca)
      Pos(av,ca)
    Pos(avIni,caIni)
    LiberarEsquina(av,ca)
  fin
  proceso enviarMsjs(E av:numero; E ca:numero)
  comenzar
    EnviarMensaje(av,r1)
    EnviarMensaje(ca,r1)
    EnviarMensaje(av,r2)
    EnviarMensaje(ca,r2)
    EnviarMensaje(av,r3)
    EnviarMensaje(ca,r3)
    EnviarMensaje(av,r4)
    EnviarMensaje(ca,r4)
  fin
  proceso robotMax(E flor:numero;ES florMax:numero;E id:numero;ES win:numero)
  comenzar
    si (flor > florMax)
      florMax:=flor
      win:= id
  fin
areas
  cuadrante: AreaPC (2,2,10,10)
  area1: AreaP(2,1,2,1)
  area2: AreaP(3,1,3,1)
  area3: AreaP(4,1,4,1)
  area4: AreaP(5,1,5,1)
  areaJefe: AreaP(1,1,1,1)
robots
  robot rRecolector
  variables
    av,ca,flor,id:numero
  comenzar
    RecibirMensaje(id,rjefe)
    RecibirMensaje(av,rjefe)
    RecibirMensaje(ca,rjefe)
    juntarFlorEsquina(flor,av,ca)
    EnviarMensaje(id,rjefe)
    EnviarMensaje(flor,rjefe)
  fin
  robot robotJefe
  variables
    av,ca,id,flor,florMax,win:numero
  comenzar
    florMax:=-1
    enviarIDs
    Random(av,2,10)
    Random(ca,2,10)
    enviarMsjs(av,ca)
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flor,r1)
      sino
        si(id=2)
          RecibirMensaje(flor,r2)
        sino
          si(id=3)
            RecibirMensaje(flor,r3)
          sino
            RecibirMensaje(flor,r4)
      robotMax(flor,florMax,id,win)
    Informar('Ganador',win)
  fin
variables
  r1,r2,r3,r4: rRecolector
  rjefe:robotJefe
comenzar
  AsignarArea(r1,cuadrante)
  AsignarArea(r1,area1)
  AsignarArea(r2,cuadrante)
  AsignarArea(r2,area2)
  AsignarArea(r3,cuadrante)
  AsignarArea(r3,area3)
  AsignarArea(r4,cuadrante)
  AsignarArea(r4,area4)
  AsignarArea(rjefe,areaJefe)
  Iniciar(rjefe,1,1)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1) 
fin