programa videoej3
procesos
  proceso juntarUnaFlor(E av: numero; E ca:numero; ES total:numero; ES termine:boolean)
  variables
    miAv,miCa:numero
  comenzar
    miAv:=PosAv
    miCa:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    si HayFlorEnLaEsquina
      tomarFlor
      total:=total+1
    sino
      termine:= V
    Pos(miAv,miCa)
    LiberarEsquina(av,ca)
  fin
  proceso actualizarMax(E id:numero; E flores:numero; ESidMax:numero; ES florMax:numero)
  comenzar
    si (flores>= floresMax)
      florMax:= flores
      idMax:= id
  fin
areas
  area1: AreaP (2,1,2,1)
  area2: AreaP (3,1,3,1)
  area3: AreaP (4,1,4,1)
  area4: AreaP (5,1,5,1)
  areaJefe: AreaP(1,1,1,1)
  cuadrante: AreaPC(2,2,10,10)
robots
  robot robotJuntador
  variables
    totalFlor: numero
    finalizar:boolean
    av,ca:numero
    id:numero
  comenzar
    floresMax:=-1
    finalizar:= F
    totalFlores:=0
    RecibirMensaje(id,robotJefe)
    RecibirMensaje(av,robotJefe)
    RecibirMensaje(ca,robotJefe)
    mientras(finalizar=F)
      juntarUnaFlor(av,ca,totalFlores,finalizar)
    EnviarMensaje(id,robotJefe)
    EnviarMensaje(totalFlores,robotJefe)  
  fin
  robot robotJefe
  variables
    av,ca,flor:numero
    idMax,florMax:numero
    id:numero
  comenzar
    Random(av,2,10)
    Random(ca,2,10)
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
    
    EnviarMensaje(av,r1)
    EnviarMensaje(ca,r1)
    EnviarMensaje(av,r2)
    EnviarMensaje(ca,r2)
    EnviarMensaje(av,r3)
    EnviarMensaje(ca,r3)
    EnviarMensaje(av,r4)
    EnviarMensaje(ca,r4)
    repetir 4
      RecibirMensaje(id,*)
      si (id=1)
        RecibirMensaje(flor, r1)
      sino
        si(id=2)
          RecibirMensaje(flor,r2)
        sino
          si(id=3)
            RecibirMensaje(flor,r3)
          sino
            RecibirMensaje(flor,r4)
      actualizarMax(id,flores,idMax,florMax)
    Informar(idMax)
  fin
variables
