programa parcial
procesos
  proceso juntarPapeles(ES papeles:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)&(papeles<10)
      tomarPapel
      papel:=papel+1
  fin
  proceso recolectarPapeles(ES papeles:numero)
  comenzar
    BloquearEsquina(5,5)
    Pos(5,5)
    juntarPapeles(papeles)
    Pos(1,1)
    LiberarEsquina(5,5)
  fin
  proceso depositarPapeles(ES papeles:numero)
    BloquearEsquina(6,6)
    Pos(6,6) 
    repetir papeles
      depositarPapel
    LiberarEsquina(6,6)
    Pos(1,1)   
  fin
areas
  esquina5: AreaC (5,5,5,5)
  esquina6: AreaC (6,6,6,6)
  area1: AreaP(1,1,1,1)
  area2: AreaP(2,2,2,2)
robots
  robot recolector1
  variables
    papeles:numero
    ok1:boolean
  comenzar
    papeles:=0
    recolectarPapeles(papeles)
    EnviarMensaje(V,r2)
    RecibirMensaje(ok1,r2)
    si(ok1)
      depositarPapeles(papeles)
      EnviarMensaje(v,r2)
      
  fin
  robot recolector2
  variables
    ok,ok2:boolean
  comenzar
    RecibirMensaje(ok,r1)
    si(ok)
      recolectarPapeles(papeles)
      EnviarMensaje(V,r1)
      RecibirMensaje(ok2,r1)
      si (ok2)
        depositarPapeles(papeles)
  fin
variables
  r1: recolector1
  r2:recolector2
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r1, esquina5)
  AsignarArea(r2, esquina5)
  AsignarArea(r1, esquina6)
  AsignarArea(r2, esquina6)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,2)
fin