programa ejemplo
procesos
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor 
      flores:=flores+1
  fin
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso hacerCuadrado(E tam:numero; ES flores:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa+tam+1
    repetir 4
      repetir tam
        juntarFlores(flores)
        mover
      juntarFlores(flores)
      derecha
    Pos(av,ca)
  fin
  proceso depositarEsq50(ES flores:numero; E av:numero; E ca:numero)
  comenzar
    BloquearEsquina(50,50)
    Pos(50,50)
    depositarFlor
    flores:=flores-1
    Pos(av,ca)
    LiberarEsquina(50,50)
  fin
  proceso actualizarMax(ES maxR:numero;ES maxEsq:numero; E id:numero;E aux:numero)
  comenzar
    si (aux > maxEsq)
      maxR:=id
      maxEsq:= aux
  fin
areas
  area1: AreaP (1,1,6,100)
  area2: AreaP (7,1,13,100)
  area3: AreaP (14,1,20,100)
  areaCoord: AreaP (51,51,51,51)
  esquina: AreaPC (50,50,50,50)
robots
  robot robot1
  variables
    id,flores:numero
    tam:numero
    av,ca:numero
    lados:numero
  comenzar
    lados:=0
    RecibirMensaje(id,rc)
    repetir 3
      Random(tam,1,4)
      lados:=lados+tam
      hacerCuadrado(tam,flores)
      av:=PosAv
      ca:=PosCa
      repetir flores
        depositarEsq50(flores,av,ca)
    lados:=lados*4
    EnviarMensaje(id,rc)
    EnviarMensaje(lados,rc)
  fin
  robot rcoordinador
  variables
    maxR,maxEsq:numero
    aux:numero
    id:numero
  comenzar
    maxR:=0
    maxEsq:=-1
    enviarIDs
    repetir 3
      RecibirMensaje(id,*)
      RecibirMensaje(aux,*)
      actualizarMax(maxR,maxEsq,id,aux)
    Informar(maxR)   
  fin
variables
  r1,r2,r3:robot1
  rc: rcoordinador
comenzar
  AsignarArea(r1,area1)
  AsignarArea(r2,area2)
  AsignarArea(r3,area3)
  AsignarArea(r1,esquina)
  AsignarArea(r2,esquina)
  AsignarArea(r3,esquina)
  AsignarArea(rc,areaCoord)
  Iniciar(r1, 1,1)
  Iniciar(r2,7,1)
  Iniciar(r3,14,1)
  Iniciar(rc, 51,51)
fin