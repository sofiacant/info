programa ejemplo
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,rA)
    EnviarMensaje(2,rB)
  fin
  proceso juntarFlores(ES flores:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
  fin
  proceso juntarFloresJefe(ES flores:numero)
  variables
    av,ca:numero
  comenzar
    av:=PosAv
    ca:=PosCa
    repetir flores
      BloquearEsquina(1,5)
      Pos(1,5)
      si(flores> 0)
        tomarFlor
        flores:= flores-1
      Pos(av,ca)
      LiberarEsquina(1,5)
  fin
  proceso depositarFlores(ES flores:numero; E av:numero; E ca:numero)
  comenzar
    BloquearEsquina(1,5)
    Pos(1,5)
    si (flores>0)
      depositarFlor
      flores:=flores-1
    Pos(av,ca)
    LiberarEsquina(1,5)
  fin
  proceso hacerEscalon(E alto:numero; E ancho:numero;ES flores:numero; ES av:numero; ES ca:numero)
  comenzar
    repetir alto
      juntarFlores(flores)
      mover
    derecha
    repetir ancho
      juntarFlores(flores)
      mover
    av:=PosAv
    ca:=PosCa
    repetir 3
      derecha
  fin
  proceso tareasPostEscalonRA(ES flores:numero;E av:numero; E ca:numero; E miID:numero)
  variables
    f:numero
  comenzar
    EnviarMensaje(V,rB)
    EnviarMensaje(av,rB)
    EnviarMensaje(ca+1,rB)
    f:=flores
    repetir flores
      depositarFlores(flores,av,ca)
    EnviarMensaje(miID,rjefe)
    EnviarMensaje(f,rjefe)  
    
  fin
  proceso tareasPostEscalonRB(ES flores:numero;E av:numero; E ca:numero; E miID:numero)
  variables
    f,ok:numero
  comenzar
    EnviarMensaje(V,rA)
    EnviarMensaje(av,rA)
    EnviarMensaje(ca+1,rA)
    f:=flores
    repetir flores
      depositarFlores(flores,av,ca)
    EnviarMensaje(miID,rjefe)
    EnviarMensaje(f,rjefe)  
    RecibirMensaje(ok,rA)
    RecibirMensaje(av,rA)
    RecibirMensaje(ca,rA)
  fin
areas
  areaescalera1:AreaP(2,1,2,5)
  areaescalera: AreaPC(2,6,23,26)
  esquina: AreaC(1,5,1,5)
  areajefe: AreaP (4,1,4,1)
robots
  robot recolectorA
  variables
    alto,ancho:numero
    ok:boolean
    av,ca:numero
    flores,f:numero
    miID:numero
  comenzar
    RecibirMensaje(miID,rjefe)
    flores:=0
    Random(alto,2,5)
    Random(ancho,2,5)
    hacerEscalon(alto,ancho,flores,av,ca) 
    tareasPostEscalonRA(flores,av,ca,miID)
    RecibirMensaje(ok,rB)
    RecibirMensaje(av,rB)
    RecibirMensaje(ca,rB)
    hacerEscalon(alto,ancho,flores,av,ca)
    tareasPostEscalonRA(flores,av,ca,miID) 
  fin
  robot recolectorB
  variables
    alto,ancho:numero
    ok:boolean
    miID:numero
    av,ca,flores,f:numero
  comenzar
    RecibirMensaje(miID,rjefe)
    Random(alto,3,6)
    Random(ancho,3,6)
    RecibirMensaje(ok,rA)
    RecibirMensaje(av,rA)
    RecibirMensaje(ca,rA)
    hacerEscalon(alto,ancho,flores,av,ca)
    tareasPostEscalonRB(flores,av,ca,miID) 
    hacerEscalon(alto,ancho,flores,av,ca)   
    flores:=f
    repetir flores
      depositarFlores(flores,av,ca)
    EnviarMensaje(miID,rjefe)
    EnviarMensaje(f,rjefe) 
  fin
  robot robotjefe
  variables  
    id:numero
    flores:numero
    f1,f2:numero
  comenzar
    f1:=0
    f2:=0
    enviarIDs
    repetir 4
      RecibirMensaje(id,*)
      si(id=1)
        RecibirMensaje(flores,rA)
        f1:=f1+flores
        juntarFloresJefe(flores)
      sino
        RecibirMensaje(flores,rB)
        f2:=f2+flores
        juntarFloresJefe(flores)
    si(f1>f2)
      Informar('robot A')
    sino
      Informar('robot B')
  fin
variables
  rA: recolectorA
  rB:recolectorB
  rjefe:robotjefe
comenzar
  AsignarArea(rA, esquina)
  AsignarArea(rA, areaescalera1)
  AsignarArea(rB, esquina)
  AsignarArea(rA, areaescalera)
  AsignarArea(rB, areaescalera) 
  AsignarArea(rjefe,areajefe)
  AsignarArea(rjefe,areaescalera)
  Iniciar(rA, 2,1)
  Iniciar(rB,3,1)
  Iniciar(rjefe,4,1)
fin