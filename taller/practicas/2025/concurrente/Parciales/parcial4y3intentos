programa parcial
procesos
  proceso juntarFloresEsq(E av: numero;E ca:numero ES flores:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
      mover 
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  comenzar
    recorrerAvenida(1)
  fin
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(R_info, 1,1)
fin