programa parcialRediT2
procesos
  proceso juntarFlor(ES f:numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      f:=f+1
  fin
  proceso acomodar
  comenzar
    repetir 3
      derecha
  fin
  proceso recorrerLado(E lado:numero; ES f:numero)
  comenzar
    repetir lado
      juntarFlor(f)
      mover
    juntarFlor(f)
    derecha
  fin
  proceso depositarFlores(E f:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni :=PosAv
    caIni :=PosCa
    repetir f
      BloquearEsquina(31,2)
      Pos(31,2)
      depositarFlor
      Pos(avIni,caIni)
      LiberarEsquina(31,2)
  fin
  proceso enviarIds
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
  fin
  proceso evaluarMax(E f:numero;E id:numero;ES max:numero;ES idMax:numero)
  comenzar
    si(f>max)
      max:=f
      idMax:=id
  fin
  proceso realizarTarea(E id:numero ;E lado:numero)
  variables
    f,lado,id:numero
    ok:boolean
  comenzar    
    f:=0
    recorrerLado(lado,f)
    EnviarMensaje(id,rJ)
    EnviarMensaje(f,rJ)
    RecibirMensaje(ok,rJ)
    si(ok=V)
      depositarFlores(f)
    si(id=1)
      EnviarMensaje(V, r2)
      EnviarMensaje(V, r3)
      RecibirMensaje(ok,*)
      RecibirMensaje(ok,*)
    sino
      si(id=2)
        EnviarMensaje(V,r1)
        EnviarMensaje(V,r3)
        RecibirMensaje(ok,*)
        RecibirMensaje(ok,*)
      sino
        EnviarMensaje(V,r1)
        EnviarMensaje(V,r2)
        RecibirMensaje(ok,*)
        RecibirMensaje(ok,*)
  fin
areas
  areaR1: AreaP (1,1,10,10)
  areaR2: AreaP (11,1,20,10)
  areaR3: AreaP (21,1,30,10)
  areaJ: AreaP (31,1,31,1)
  areaDepo: AreaC (31,2,31,2)
 
robots
  robot robotJefe
  variables
    lado1,lado2,lado3,f,id,max,idMax:numero
  comenzar
    enviarIds
    Random(lado1,1,9)
    Random(lado2,1,9)
    Random(lado3,1,9)
    EnviarMensaje(lado1,r1)
    EnviarMensaje(lado2,r2)
    EnviarMensaje(lado3,r3)
    repetir 4
      max:=-1
      repetir 3
        RecibirMensaje(id,*)
        si(id=1)
          RecibirMensaje(f, r1)
        sino 
          si(id=2)
            RecibirMensaje(f, r2)
          sino
            RecibirMensaje(f, r3)      
        evaluarMax(f,id,max,idMax) 
      si(idMax = 1) {verdadero es el que perdio}
        EnviarMensaje(V, r2)
        EnviarMensaje(V, r3)
        EnviarMensaje(F, r1)
      sino
        si(idMax=2)
          EnviarMensaje(V, r1)
          EnviarMensaje(V, r3)
          EnviarMensaje(F, r2)
        sino
          EnviarMensaje(V, r2)
          EnviarMensaje(V, r1)
          EnviarMensaje(F, r3)
  fin
  robot robotPerimetral
  variables
    lado,id:numero
  comenzar
    RecibirMensaje(id,rJ)
    RecibirMensaje(lado,rJ)
    repetir 4
      realizarTarea(id,lado)
  fin
variables
  r1,r2,r3:robotPerimetral
  rJ:robotJefe
comenzar
  AsignarArea(r1,areaR1)
  AsignarArea(r2,areaR2)
  AsignarArea(r3,areaR3)
  AsignarArea(rJ,areaJ)
  AsignarArea(r1,areaDepo)
  AsignarArea(r2,areaDepo)
  AsignarArea(r3,areaDepo)
  Iniciar(r1,1,1)
  Iniciar(r2,11,1)
  Iniciar(r3,21,1)
  Iniciar(rJ,31,1)
fin