{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ej4p4
procesos
  proceso juntarFlores(E av:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
    Pos(avIni,caIni)
    LiberarEsquina(av,ca) 
  fin
  proceso juntarPapeles(E av:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras(HayPapelEnLaEsquina)
      tomarPapel
    Pos(avIni,caIni)
    LiberarEsquina(av,ca) 
  fin
  proceso vaciarBolsa(E av:numero; E ca:numero)
  variables
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    BloquearEsquina(av,ca)
    Pos(av,ca)
    mientras(HayFlorEnLaBolsa)
      depositarFlor
    mientras(HayPapelEnLaBolsa)
      depositarPapel
    Pos(avIni,caIni)
    LiberarEsquina(av,ca)     
  fin
areas
  cuadrante: AreaC (2,2,100,100)
  areajefe: AreaP (1,1,1,1)
  area1: AreaP(2,1,2,1)
  area2: AreaP (3,1,3,1)
robots
  robot robot1
  variables
    tarea,id:numero 
    av,ca:numero
  comenzar
    RecibirMensaje(id,jefe)
    mientras(tarea <> 4)
      RecibirMensaje(tarea,jefe)
      si(tarea=1)
        RecibirMensaje(av,jefe)
        RecibirMensaje(ca,jefe)
        juntarFlores(av,ca)
      sino
        si(tarea=2)
          RecibirMensaje(av,jefe)
          RecibirMensaje(ca,jefe)
          juntarPapeles(av,ca)
        sino
          si(tarea=3)
            RecibirMensaje(av,jefe)
            RecibirMensaje(ca,jefe)
            vaciarBolsa(av,ca)
  fin
  robot robotjefe
  variables
    tarea:numero
    r,av,ca:numero
  comenzar
    EnviarMensaje(1,t1)
    EnviarMensaje(2,t2)
    repetir 10
      Random(tarea,1,3) 
      Random(r,1,2)
      Random(av,2,100)
      Random(ca,2,100)
      si (r = 1)
        EnviarMensaje(tarea,t1)
        EnviarMensaje(av,t1)
        EnviarMensaje(ca,t1)
      sino
        EnviarMensaje(tarea,t2)
        EnviarMensaje(av,t2)
        EnviarMensaje(ca,t2)
    EnviarMensaje(4,t1)
    EnviarMensaje(4,t2)     
  fin
variables
  t1,t2: robot1
  jefe: robotjefe
comenzar
  AsignarArea(t1, cuadrante)
  AsignarArea(t2,cuadrante)
  AsignarArea(t1,area1)
  AsignarArea(t2,area2)
  AsignarArea(jefe,areajefe)
  Iniciar(jefe, 1,1)
  Iniciar(t1,2,1)
  Iniciar(t2,3,1)
fin