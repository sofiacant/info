{1- Clientes y Servidores Existe un robot que sirve de flores a tres robots clientes. Cada cliente solicita al servidor que le deposite en su esquina siguiente una cantidad de flores aleatoria (entre 1 y 4). Por ejemplo, si el cliente se encuentra en la esquina (2,1) le solicitará que coloque x cantidad de flores en la esquina (2,2).   Cuando el robot servidor deposita las flores en la esquina solicitada, el cliente las junta y las deposita una a una a lo largo de la avenida en la que se encuentra. El programa finaliza cuando todos los robos clientes completan su avenida. Asuma que el robot servidor tiene flores suficientes en su bolsa.  El robot servidor se inicia en la esquina (100,100) Los robots clientes inician en las esquinas (1,1) , (2,1) y (3,1) respectivamente .}

programa ej1p4
procesos
  proceso enviarIDS
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)    
  fin
  proceso floresServidor(E av:numero; E ca:numero; E flores:numero)
  comenzar
    Pos(av, ca)
    repetir flores
      depositarFlor
    Pos(100,100)
  fin
  proceso depositoFloresAvenida(E flores:numero)
  comenzar
    repetir flores
      depositarFlor
      si(PosCa < 100)
        mover
  fin
  proceso avisoServidor(id:numero)
  variables
    flores:numero
    av,ca:numero
    ok:boolean
  comenzar
    mientras(PosCa<100)
      Random(flores,1,4)
      av:=PosAv
      ca:=PosCa+1
      EnviarMensaje(id,rs)
      EnviarMensaje(flores,rs)
      EnviarMensaje(av,rs)
      EnviarMensaje(ca,rs) 
      RecibirMensaje(ok,rs)
      Pos(av,ca)
      repetir flores
        tomarFlor
      Pos(av,ca-1)
      depositoFloresAvenida(flores)
    EnviarMensaje(id,rs)
    EnviarMensaje(0,rs)
areas
  areaservidor: AreaP (100,100,100,100)
  area1: AreaC (1,1,1,100)
  area2: AreaC (2,1,2,100)
  area3: AreaC (3,1,3,100)
  
robots
  robot robotcliente
  variables
    id:numero
  comenzar
    RecibirMensaje(id,rs)
    avisoServidor(id)
  fin
  robot robotservidor
  variables
    id,av,ca:numero
    ok1,ok2,ok3:boolean
    flores:numero
  comenzar
    enviarIDS
    ok1:=V
    ok2:=V
    ok3:=V
    mientras (ok1) | (ok2) | (ok3)
      RecibirMensaje(id,*)
      si (id=1)
        RecibirMensaje(flores,r1)
        si(flores<>0)
          RecibirMensaje(av,r1)
          RecibirMensaje(ca,r1)
          floresServidor(av,ca,flores)
          EnviarMensaje(V,r1)
        sino
          ok1:=F
      sino
         si (id=2)
           RecibirMensaje(flores,r2)
           si(flores<>0)
             RecibirMensaje(av,r2)
             RecibirMensaje(ca,r2)
             floresServidor(av,ca,flores)
             EnviarMensaje(V,r2)
           sino
             ok2:=F
         sino
           RecibirMensaje(flores,r3)
           si (flores<>0)
             RecibirMensaje(av,r3)
             RecibirMensaje(ca,r3)
             floresServidor(av,ca,flores)
             EnviarMensaje(V,r3) 
           sino
             ok3:=F
  fin
variables
  r1,r2,r3: robotcliente
  rs:robotservidor
comenzar
  AsignarArea(rs, areaservidor)
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(rs,area1)
  AsignarArea(rs,area2)
  AsignarArea(rs,area3)
  Iniciar(rs, 100,100)
  Iniciar(r1, 1,1)
  Iniciar(r2, 2,1)
  Iniciar(r3, 3,1)
fin