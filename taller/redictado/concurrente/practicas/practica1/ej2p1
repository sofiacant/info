{ Realice un programa en el que 4 robots limpien de papeles el perímetro de un cuadrado de lado 20 en sentido horario. El vértice inferior izquierdo del cuadrado se ubica en la esquina (10,10). Al finalizar, cada robot debe informar la cantidad de papeles juntados en su lado.}

programa ej2p1
procesos
  proceso juntarPapeles(ES papel:numero)
  comenzar
    mientras HayPapelEnLaEsquina
      tomarPapel
      papel:=papel+ 1
  fin
  proceso recorrerAvenida
  variables
    papel:numero
  comenzar
    papel:=0
    repetir 19
      juntarPapeles(papel)
      mover
    juntarPapeles(papel)
    Informar('papeles', papel)
  fin
areas
  area1: AreaP (10,10,10,29) 
  area2: AreaP (10,30,29,30)
  area3: AreaP (30,11,30,30)
  area4: AreaP (11,10,30,10)
robots
  robot robot1
  comenzar
    si ((PosAv=10) & (PosCa=10))
      Pos(10,10)
      recorrerAvenida
    sino
      si ((PosAv=10) & (PosCa=30))
        Pos(10,30)
        derecha
        recorrerAvenida
      sino
        si ((PosAv=30) & (PosCa=30))
          repetir 2 
            derecha
          Pos(30,30)
          recorrerAvenida
        sino {((PosAv=30) & (PosCa=10))}
          Pos(30,10)
          repetir 3
            derecha
          recorrerAvenida
  fin
  
variables
  r1: robot1
  r2: robot1
  r3: robot1
  r4: robot1  
comenzar
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(r4, area4)
  Iniciar(r1, 10,10)
  Iniciar(r2, 10,30)   
  Iniciar(r3, 30,30)
  Iniciar(r4, 30,10)
fin