{1) Realice un programa para que un robot junte todas las flores de la avenida 1 y las deposite al final de dicha avenida. Al finalizar, debe informar la cantidad de flores depositadas y la cantidad de esquinas sin flores que encontró durante el recorrido. .
{b) Modifique el programa anterior para que el trabajo sea realizado por 3 robots: uno realiza la avenida 1, otro realiza la avenida 3 y otro la avenida 5. Cada robot debe iniciar en las esquina (1,1), (3,1) y (5,1) respectivamente}

programa ej1p1
procesos
  proceso juntarFlores(ES flores:numero; ES cantEsq:numero)
  comenzar
    si HayFlorEnLaEsquina
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        flores:= flores + 1 
    sino
      cantEsq:=cantEsq+1
  fin
  
  proceso recorrerAvenida(ES flores:numero)
  variables
    floresD,cantEsq:numero
  comenzar
    cantEsq:=0
    floresD:=0
    repetir 99
      juntarFlores(flores,cantEsq)
      mover
    juntarFlores(flores,cantEsq)
    floresD:= flores
    repetir flores
      depositarFlor
      flores:=flores-1
    Informar('Flores', floresD)
    Informar('Cantidad de esquinas sin flores', cantEsq)
  fin
areas
  ciudad1: AreaP (1,1,1,100)
  ciudad2: AreaP (3,1,3,100)
  ciudad3: AreaP (5,1,5,100)
robots
  robot robot1
  variables
    flores:numero
  comenzar
    flores:=0
    recorrerAvenida(flores)
  fin
variables
  r1: robot1
  r2: robot1
  r3: robot1
comenzar
  AsignarArea(r1, ciudad1)
  AsignarArea(r2, ciudad2)
  AsignarArea(r3, ciudad3)
  Iniciar(r1, 1,1)
  Iniciar(r2, 3,1)
  Iniciar(r3, 5,1)
fin