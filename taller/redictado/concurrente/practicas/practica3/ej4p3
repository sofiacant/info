{4- Realice un programa en el que 4 robots mueven de a una todas las flores de la esquina (10,10) a la esquina (11,11). Para ello, cada robot que toma una flor de la esquina (10,10) la deposita en la esquina (11,11) y luego retorna a su esquina inicial. Cada robot que finaliza (o, sea, que detecta que la esquina (10,10) se ha vaciado) deberá avisar al robot coordinador que ha finalizado. Cuando todos los robots finalizaron, el robot coordinador deberá informar qué robot finalizó último y a continuación deberá recolectar todas las flores de la esquina (11,11). .}

programa ej4p3
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin
  proceso juntarFlores
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
  fin
  proceso tomaryDepositar(E id:numero)
  variables
    ok:boolean
    avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    ok:=V
    mientras (ok)
      BloquearEsquina(10,10)
      Pos(10,10)
      si (HayFlorEnLaEsquina)
        tomarFlor
      sino
        ok:=F
        EnviarMensaje(id,rc)
        Pos(avIni,caIni)
        LiberarEsquina(10,10)
      si (ok)
        BloquearEsquina(11,11)
        Pos(11,11)
        LiberarEsquina(10,10)
        depositarFlor
        Pos(avIni,caIni)
        LiberarEsquina(11,11)
  fin
areas
  esquina10: AreaPC (10,10,10,10)
  esquina11: AreaPC (11,11,11,11)
  areacoordinador: AreaP (1,1,1,1)
  area1: AreaP (9,9,9,9)
  area2: AreaP (9,10,9,10)
  area3: AreaP (9,11,9,11)  
  area4: AreaP (9,12,9,12)
robots
  robot robot1
  variables
    id:numero
  comenzar
    RecibirMensaje(id, rc)
    tomaryDepositar(id)
  fin
  robot coordinador
  variables
    ult,id:numero
  comenzar
    enviarIDs
    repetir 3
      RecibirMensaje(id,*)
    RecibirMensaje(id,*)
    ult:=id
    Informar(ult)
    juntarFlores   
  fin
variables
  r1,r2,r3,r4: robot1
  rc:coordinador
comenzar
  AsignarArea(rc, areacoordinador)
  AsignarArea(r1, esquina10)
  AsignarArea(r2, esquina10)
  AsignarArea(r3, esquina10)
  AsignarArea(r4, esquina10)
  AsignarArea(r1, esquina11)
  AsignarArea(r2, esquina11)
  AsignarArea(r3, esquina11)  
  AsignarArea(r4, esquina11)
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(r4, area4)
  Iniciar(rc, 1,1)
  Iniciar(r1,9,9)
  Iniciar(r2,9,10)
  Iniciar(r3,9,11)
  Iniciar(r4,9,12)
fin