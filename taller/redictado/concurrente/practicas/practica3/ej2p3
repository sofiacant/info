{Realice un programa en el cual 2 robots corren una carrera. El recorrido realizado por cada uno es el que se muestra en la siguiente figura. Durante el recorrido el robot 1 debe juntar todas las flores que encuentre en los vértices de cada escalón, y el robot 2 debe juntar todos los papeles que encuentre en los vértices de cada escalón. Al finalizar deben informar la cantidad de elementos recogidos. El robot 1 debe iniciar su recorrido en la esquina (1,1) y el robot 2 en la esquina (31,1).  Al finalizar la carrera, un robot jefe (inicializado en la esquina (15,1) ) debe informar qué robot llegó primero a la esquina central de su recorrido.}

programa ej2p4
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso juntarPapeles(ES p:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      p:=p+1
  fin
  proceso juntarFlores(ES f:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:=f+1
  fin
  proceso escalonF(ES f: numero; E cant:numero)
  comenzar
    juntarFlores(f)
    repetir cant
      mover
  fin
  proceso escalonP(ES p:numero; E cant:numero)
  comenzar
    juntarPapeles(p)
    repetir cant
      mover
  fin
  proceso esquinaMedioP(ES p:numero)
  comenzar
    mover
    juntarPapeles(p)
    izquierda
    BloquearEsquina(16,16)
    mover
    juntarPapeles(p)
    repetir 2
      derecha
    mover
    LiberarEsquina(16,16)
    mover
    mover
  fin
  proceso esquinaMedioF(ES f:numero)
  comenzar
    mover
    juntarFlores(f)
    derecha
    BloquearEsquina(16,16)
    mover
    juntarFlores(f)
    repetir 2
      derecha
    mover
    LiberarEsquina(16,16)
  fin
  proceso inversoFlores(ES f:numero)
  variables
    cant:numero
  comenzar
    cant:=2
    repetir 4
      escalonF(f,cant)
      derecha
      escalonF(f,cant)
      izquierda
      cant:=cant+1
  fin
  proceso inversoPapeles(ES p:numero)
  variables
    cant:numero
  comenzar
    cant:=2
    repetir 3
      escalonP(p,cant)
      derecha
      cant:=cant+1 
      escalonP(p,cant)
      izquierda
    juntarPapeles(p)
    repetir 5
      mover
  fin
areas
  areajefe: AreaP (15,1,15,1)
  areaR1: AreaP (1,1,15,30)

  areaR2: AreaP (17,1,31,30)
  esquina: AreaPC (16,16,16,16)
robots
  robot robot1
  variables
    cant,f:numero
  comenzar
    f:=0
    cant:=5
    repetir 4
      escalonF(f,cant)
      derecha
      escalonF(f,cant)
      izquierda
      cant:=cant-1
    esquinaMedioF(f)
    inversoFlores(f)
    Informar(f)
    EnviarMensaje(1,jefe)
    EnviarMensaje(V,jefe)
  fin
  robot robot2
  variables
    cant,p:numero
  comenzar
    p:=0
    cant:=5
    repetir 4
      escalonF(p,cant)
      izquierda
      escalonF(p,cant)
      derecha
      cant:=cant-1
    esquinaMedioP(p)
    izquierda
    inversoPapeles(p)
    Informar(p)
    EnviarMensaje(2,jefe)
    EnviarMensaje(V,jefe)
  fin
  robot robotjefe
  variables
    win,id:numero
    ok: boolean
  comenzar
    RecibirMensaje(id,*)
    win:= id
    RecibirMensaje(id,*)
    repetir 2
      RecibirMensaje(ok,*)
    Informar(win)
  fin
variables
  r1: robot1
  r2: robot2
  jefe: robotjefe
comenzar
  AsignarArea(r1, areaR1)
  AsignarArea(r2, areaR2) 
  AsignarArea(r1, esquina) 
  AsignarArea(r2, esquina) 
  AsignarArea(jefe, areajefe)
  Iniciar(r1, 1,1)
  Iniciar(r2,31,1)
  Iniciar(jefe,15,1)
fin