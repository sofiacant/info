{3-Realice un programa donde 4 robots colaboren para recoger todas las flores de una esquina indicada por un robot jefe, seleccionada de manera aleatoria dentro del cuadrante (2,2) y (10,10). Para ello el jefe determina inicialmente una esquina y los robots deben accederla, tomar de a una las flores y volver a su posición inicial. Cuando los robots terminan el jefe deberá informar cuál de ellos logró recoger más flores.  Las esquinas de inicio de los robots deberán ser jefe (1,1) y robots (2,1), (3, 1), (4,1) y (5,1).  .}

programa ejemplo
procesos
  proceso enviarIds
  comenzar
    EnviarMensaje(1,r1)
    EnviarMensaje(2,r2)    
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
  fin
  proceso enviarEsquina(E av:numero; E ca:numero)
  comenzar
    EnviarMensaje(av,r1)
    EnviarMensaje(ca,r1)
    EnviarMensaje(av,r2)
    EnviarMensaje(ca,r2)
    EnviarMensaje(av,r3)
    EnviarMensaje(ca,r3)
    EnviarMensaje(av,r4)
    EnviarMensaje(ca,r4)
  fin
  proceso irEsquina(E av:numero; E ca:numero; ES f:numero)
  variables
    avIni,caIni:numero
    ok:boolean
  comenzar
    avIni:=PosAv
    caIni:= PosCa 
    ok:=V
    mientras (ok)
      BloquearEsquina(av,ca)
      Pos(av,ca)
      si(HayFlorEnLaEsquina)
        tomarFlor
        f:=f+1
      sino
        ok:=F
      Pos(avIni,caIni)
      LiberarEsquina(av,ca)
  fin
  proceso maximo(E id:numero; E f:numero; ES maxR:numero; ES maxF:numero)
  comenzar
    si (f> maxF)
      maxF:=f
      maxR:=id
  fin
areas
  cuadrante: AreaPC (2,2,10,10)
  areaJefe: AreaP (1,1,1,1)
  area1: AreaP(2,1,2,1)
  area2: AreaP(3,1,3,1)
  area3: AreaP(4,1,4,1)
  area4: AreaP(5,1,5,1)
robots
  robot juntador
  variables
    id,f:numero
    av,ca:numero  
  comenzar
    RecibirMensaje(id,jefe)
    RecibirMensaje(av,jefe)
    RecibirMensaje(ca,jefe)
    f:=0
    irEsquina(av,ca,f)
    EnviarMensaje(id,jefe)
    EnviarMensaje(f,jefe)
  fin
  robot robotjefe
  variables
    id,f:numero
    av,ca:numero
    maxR,maxF:numero
  comenzar
    maxF:=-1
    maxR:= -1
    enviarIds
    Random(av,2,10)
    Random(ca,2,10)
    enviarEsquina(av,ca)
    repetir 4
      RecibirMensaje(id,*)
      si (id = 1)
        RecibirMensaje(f,r1)
      sino
        si(id = 2)
          RecibirMensaje(f,r2)
        sino
          si(id = 3)
            RecibirMensaje(f,r3)
          sino
            RecibirMensaje(f,r4)
      maximo(id,f,maxR,maxF)
    Informar(maxR)
  fin
variables
  r1,r2,r3,r4:juntador
  jefe: robotjefe
comenzar
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(r3, cuadrante)
  AsignarArea(r4, cuadrante)
  AsignarArea(r1, area1)
  AsignarArea(r2, area2)
  AsignarArea(r3, area3)
  AsignarArea(r4, area4)
  AsignarArea(jefe, areaJefe)
  Iniciar(jefe, 1,1)
  Iniciar(r1,2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1)
fin