{ Realice un programa en el que un robot fiscalizador controla el acceso de 4 robots recolectores al cuadrante encerrado entre las esquinas (25,25) y (75,75) . Para ello, el robot fiscalizador avisa a un robot recolector aleatorio que puede ingresar al área. El robot que recibe la autorización de acceso calcula una esquina aleatoria dentro del área, limpia dicha esquina de flores y papeles, regresa a su esquina y avisa al robot fiscalizador que ya finalizó.  
{   Se realizarán en total 10 accesos al cuadrante entre los 4 robots recolectores. Al finalizar, el robot fiscalizador deberá indicar al robot ganador (el que juntó más objetos en total) que se posicione en la esquina (50,50). El robot fiscalizador inicia en la esquina (1,1) y los robots recolectores inician en las esquinas (25,1) (30,1) (35,1) y (40,1) respectivamente. .}

programa ej4p2
procesos
  proceso juntarObjetos(ES obj:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      obj:=obj+1
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      obj:=obj+1
  fin
  proceso inicializar(ES c1:numero; ES c2:numero; ES c3:numero; ES c4:numero)
  comenzar
    c1:= 0
    c2:= 0    
    c3:= 0
    c4:= 0
  fin
  proceso entrarAlCuadrante(ES obj:numero)
  variables
    av,ca,avIni,caIni:numero
  comenzar
    avIni:=PosAv
    caIni:=PosCa
    Random(av,25,75)
    Random(ca,25,75)
    Pos(av,ca)
    juntarObjetos(obj)
    Pos(avIni,caIni)
  fin
   proceso obtenerMas(E c1:numero; E c2:numero; E c3:numero; E c4:numero; ES maxRobot:numero)
  variables
    max:numero
  comenzar
    max:= -1
    si c1 > max
      max := c1
      maxRobot := 1
    si c2 > max
      max := c2
      maxRobot := 2
    si c3 > max
      max := c3
      maxRobot := 3
    si c4 > max
      max := c4
      maxRobot := 4
  fin
  proceso avisarRobot (E id:numero; E ok: boolean)
  comenzar
    si (id = 1)
      EnviarMensaje(ok, robot1)
    sino
      si (id=2)
        EnviarMensaje(ok, robot2)
      sino
        si (id=3)
          EnviarMensaje(ok, robot3)
        sino
          EnviarMensaje(ok, robot4)
  fin
  proceso finalizar
  comenzar
    EnviarMensaje(F,r1)
    EnviarMensaje(F,r2)
    EnviarMensaje(F,r3)
    EnviarMensaje(F,r4)
  fin
areas
  esqGanador: AreaPC (50,50,50,50)
  cuadrante: AreaPC (25,25,75,75)
  calleInicial: AreaPC(25,1,40,1)
  areaFiscal: AreaP (1,1,1,1)
robots
  robot recolector
  variables
    ok,gano:boolean
    obj:numero
  comenzar
    obj:=0
    RecibirMensaje(ok,rf)
    mientras(ok)
      RecibirMensaje(obj,rf)
      entrarAlCuadrante(obj)
      EnviarMensaje(obj,rf)
      RecibirMensaje(ok,rf)
    RecibirMensaje(gano,rf)
    si(gano)
      Pos(50,50)
  fin
  robot fiscal
  variables
    c1,c2,c3,c4:numero
    id:numero
  comenzar
    inicializar(c1,c2,c3,c4) 
    repetir 10
      Random(id,1,4)
      si(id=1)
        EnviarMensaje(V,r1)
        EnviarMensaje(c1,r1)
        RecibirMensaje(c1,r1)
      sino 
        si (id=2)
        EnviarMensaje(V,r2)
        EnviarMensaje(c3,r2)
        RecibirMensaje(c3,r2)
        sino
           si(id=1)
            EnviarMensaje(V,r3)
            EnviarMensaje(c3,r3)
            RecibirMensaje(c3,r3)
           sino
              si(id=4)
                EnviarMensaje(V,r4)
                EnviarMensaje(c4,r4)
                RecibirMensaje(c4,r4)
    finalizar
    obtenerMas(c1,c2,c3,c4,max)
    id:=1
    repetir 4
      si(id = max)
        ok:= V
      sino
        ok:= F
      avisarRobot(id,ok)
      id:= id+1  
    Informar('Ganador',max)  
  fin
variables
  r1:recolector
  r2:recolector
  r3:recolector
  r4:recolector
  rf: fiscal
comenzar
  AsignarArea(r1, calleInicial)
  AsignarArea(r2, calleInicial)
  AsignarArea(r3, calleInicial)
  AsignarArea(r4, calleInicial)
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(r3, cuadrante)
  AsignarArea(r4, cuadrante)
  AsignarArea(rf, areaFiscal)
  Iniciar(r1, 25,1)
  Iniciar(r2, 30,1)
  Iniciar(r3, 35,1)
  Iniciar(r4, 40,1)
  Iniciar(rf, 1,1)
fin